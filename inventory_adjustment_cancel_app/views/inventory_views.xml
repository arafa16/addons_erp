<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="stock_adjestment_inherit_view_form" model="ir.ui.view">
            <field name="name">stock.inventory.view.form</field>
            <field name="model">stock.inventory</field>
            <field name="inherit_id" ref="stock.view_inventory_form"/>
            <field name="arch" type="xml">
            <xpath expr="//button[@name='action_done']" position="after">
                  <button name="cancel_stock_inventory"  string="Cancel" type="object"
                          groups="account.group_account_manager" attrs="{'invisible': [('state', 'not in', ('done'))]}"/>
            </xpath>
            <field name="filter" position="after">
                  <field name="is_cancel_inv" invisible="1"/>
            </field>
            <xpath expr="//notebook[1]" position="attributes">
                 <attribute name="attrs">{'invisible': [('state','=','draft'),('is_cancel_inv','!=',True)]}</attribute>
            </xpath>
            </field>
        </record>
</odoo>