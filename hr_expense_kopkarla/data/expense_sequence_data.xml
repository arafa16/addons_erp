<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequences for Advance Expense -->
        <record id="cash_advance_seq" model = "ir.sequence">
            <field name="name">Cash Advance</field>
            <field name="code">hr.advance</field>
            <field name="prefix">ADV/</field>
            <field name="padding">4</field>
        </record>

        <record id="expense_seq" model = "ir.sequence">
            <field name="name">Expense</field>
            <field name="code">hr.expense.sheet</field>
            <field name="prefix">EXP/</field>
            <field name="padding">4</field>
        </record>
    </data>
</odoo>
