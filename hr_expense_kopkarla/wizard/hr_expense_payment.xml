<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <record id="hr_expense_payment_wizard_form" model="ir.ui.view">
            <field name="name">hr.expense.payment.wizard.form</field>
            <field name="model">hr.expense.payment.wizard</field>
            <field name="arch" type="xml">
                <form string="Register Payment">
                    <sheet>
                        <field name="id" invisible="1"/>
                        <div class="oe_title">
                            <h1>Expense Payment</h1>
                        </div>
                        <group>
                            <group>
                                <field name="sheet_id"/>
                                <field name="employee_id"/>
                                <field name="payment_date"/>
                                <field name="communication" readonly="1"/>
                                <field name="partner_id" required="1" readonly="1" invisible="1"
                                context="{'default_is_company': True, 'default_supplier': True}"/>
                                <field name="hide_payment_method" invisible="1"/>
                                <field name="payment_method_id" widget="radio" attrs="{'invisible': [('hide_payment_method', '=', True)]}"/>
                            </group>
                            <group>
                                <label for="expense_amount" attrs="{'invisible': [('advance_amount', '=', 0)]}"/>
                                <div name="expense_amount_div" class="o_row" attrs="{'invisible': [('advance_amount', '=', 0)]}">
                                    <field name="expense_amount" readonly="1"/>
                                    <field name="currency_id" invisible="1" options="{'no_create': True, 'no_open': True}" groups="base.group_multi_currency"/>
                                </div>
                                <field name="payment_mode" widget="radio" attrs="{'readonly': [('advance_amount', '!=', 0)]}" invisible="1"/>
                                <label for="advance_amount" attrs="{'invisible': [('advance_amount', '=', 0)]}"/>
                                <div name="advance_amount_div" class="o_row" attrs="{'invisible': [('advance_amount', '=', 0)]}">
                                    <field name="advance_amount" readonly="1"/>
                                    <field name="currency_id" invisible="1" options="{'no_create': True, 'no_open': True}" groups="base.group_multi_currency"/>
                                </div>
                                <label for="amount" attrs="{'invisible': [('amount', '=', 0)]}"/>
                                <div name="amount_div" class="o_row" attrs="{'invisible': [('amount', '=', 0)]}">
                                    <field name="amount" readonly="1"/>
                                    <field name="currency_id" invisible="1" options="{'no_create': True, 'no_open': True}" groups="base.group_multi_currency"/>
                                </div>
                                <field name="ret_journal_id" widget="selection" attrs="{'invisible': [('amount', '>=', 0)]}"/>
                                <field name="journal_id" widget="selection" attrs="{'invisible': [('amount', '=', 0)]}"/>
                            </group>
                        </group>
                    </sheet>
                    <footer>
                        <button string='Validate' name="expense_post_payment" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-default" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Expenses -->
        <record id="hr_expense_sheet_register_payment_wizard_action" model="ir.actions.act_window">
            <field name="name">Register Payment</field>
            <field name="res_model">hr.expense.payment.wizard</field>
            <field name="view_type">form</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="hr_expense_payment_wizard_form"/>
            <field name="target">new</field>
            <field name="context">{'default_payment_type': 'outbound'}</field>
            <field name="domain">[('partner_type', '=', 'supplier')]</field>
        </record>

</odoo>