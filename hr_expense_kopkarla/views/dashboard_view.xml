        <record model="ir.ui.view" id="dashboard_expense_view">
            <field name="name">Dashboard</field>
            <field name="model">board.board</field>
            <field name="type">form</field>
            <field name="customViewID">dashboard_expense_view</field>
            <field name="arch" type="xml">
                <form string="Dashboard">
                    <board style="1-1">
                        <column>
                            <action string="Cash Advance Plan" name="%(cash_advance_plan_act_tree_board)d"/>
                            <action string="Un-settled Cash Advance" name="%(cash_advance_unsettle_act_tree_board)d"/>
                        </column>
                        <column>
                            <action string="Expense / Reimbursement / Advance Settlement Plan" name="%(expense_plan_act_tree_board)d"/>
                            <action string="Cash Out" name="%(cash_advance_plan_act_graph_board)d"/>
                        </column>
                    </board>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="dashboard_expense_action">
            <field name="name">Dashboard Expense</field>
            <field name="res_model">board.board</field>
            <field name="view_mode">form</field>
            <field name="usage">menu</field>
            <field name="view_id" ref="dashboard_expense_view"/>
        </record>

        <menuitem id="menu_dashboard_expense" name="Dashboard" sequence="1"
                  parent="hr_expense.menu_hr_expense_root" action="dashboard_expense_action"
                  groups="account.group_account_manager,account.group_account_invoice"/>

        <menuitem id="hr_expense.menu_hr_expense_my_expenses" name="My Expenses" sequence="2"
                  parent="hr_expense.menu_hr_expense_root" groups="base.group_user"/>

    </data>
</odoo>
