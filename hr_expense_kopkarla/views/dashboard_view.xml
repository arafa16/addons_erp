<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--    <data noupdate="0">-->
    <data>
        <record id="cash_advance_plan_view_graph_board" model="ir.ui.view">
            <field name="name">cash.advance.plan.graph.board</field>
            <field name="model">hr.advance</field>
            <field name="arch" type="xml">
                <graph string="Cash Advance Graph" type="bar">
                    <field name="state"/>
                    <field name="total_amount_expense" type="measure"/>
                </graph>
            </field>
        </record>
        <record id="cash_advance_plan_act_graph_board" model="ir.actions.act_window">
            <field name="name">Cash Out Plan</field>
            <field name="res_model">hr.advance</field>
            <field name="view_mode">graph</field>
            <field name="view_id" ref="hr_expense_kopkarla.cash_advance_plan_view_graph_board"/>
            <field name="domain">[('state', 'in', ['draft', 'confirm', 'approved_hr_manager'])]</field>
        </record>

        <record id="cash_advance_plan_view_tree_board" model="ir.ui.view">
            <field name="name">cash.advance.plan.tree.board</field>
            <field name="model">hr.advance</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="employee_id"/>
                    <field name="plan_date"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="total_amount_expense" sum="Total"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>
        <record id="cash_advance_plan_act_tree_board" model="ir.actions.act_window">
            <field name="name">Cash Advance Plan</field>
            <field name="res_model">hr.advance</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="hr_expense_kopkarla.cash_advance_plan_view_tree_board"/>
            <field name="domain">[('state', 'in', ['draft', 'confirm', 'approved_hr_manager'])]</field>
        </record>

        <record id="cash_advance_unsettle_view_tree_board" model="ir.ui.view">
            <field name="name">cash.advance.plan.tree.board</field>
            <field name="model">hr.advance</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="employee_id"/>
                    <field name="plan_date"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="total_amount_expense" sum="Total"/>
                    <field name="expense_id"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>
        <record id="cash_advance_unsettle_act_tree_board" model="ir.actions.act_window">
            <field name="name">Un-settled Cash Advance</field>
            <field name="res_model">hr.advance</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="hr_expense_kopkarla.cash_advance_unsettle_view_tree_board"/>
            <field name="domain">[('state', 'in', ['paid'])]</field>
        </record>

        <record id="expense_plan_view_tree_board" model="ir.ui.view">
            <field name="name">expense.plan.tree.board</field>
            <field name="model">hr.expense.sheet</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="employee_id"/>
                    <field name="report_date"/>
                    <field name="payment_mode"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="expense_amount" sum="Total"/>
                    <field name="advance_id"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>
        <record id="expense_plan_act_tree_board" model="ir.actions.act_window">
            <field name="name">Expense / Reimbursement / Advance Settlement Plan</field>
            <field name="res_model">hr.expense.sheet</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="hr_expense_kopkarla.expense_plan_view_tree_board"/>
            <field name="domain">[('state', 'in', ['submit', 'approve'])]</field>
        </record>

