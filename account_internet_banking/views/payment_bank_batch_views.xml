<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_payment_bank_batch_search" model="ir.ui.view">
            <field name="name">payment.bank.batch.search</field>
            <field name="model">payment.bank.batch</field>
            <field name="arch" type="xml">
                <search string="Batch Payment">
                    <field name="name" filter_domain="['|', ('name','ilike',self)]" string="Name"/>
                    <separator/>
                    <field name="journal_id" />
                    <!--<filter string="Draft" domain="[('state','=','draft')]" name='state_draft'/>
                    <filter string="Posted" domain="[('state','=','posted')]" name='state_posted'/>-->
                    <separator/>
                    <filter string="Bank" domain="[]" context="{'group_by': 'journal_id'}"/>
                    <filter string="State" domain="[]" context="{'group_by': 'state'}"/>
                </search>
            </field>
        </record>
        <record id="view_payment_bank_batch_tree" model="ir.ui.view">
            <field name="name">payment.bank.batch.tree</field>
            <field name="model">payment.bank.batch</field>
            <field name="arch" type="xml">
<!--                <tree decoration-info="state == 'draft'" decoration-muted="state in ['reconciled', 'cancelled']" edit="false">-->
                <tree edit="false">
                    <field name="date"/>
                    <field name="name"/>
                    <field name="journal_id"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="amount"/>
                    <field name="line_ids"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>
        <record id="view_payment_bank_batch_form" model="ir.ui.view">
            <field name="name">payment.bank.batch.form</field>
            <field name="model">payment.bank.batch</field>
            <field name="arch" type="xml">
                <form string="Payment Batch">
                    <header>
                        <button name="export" class="oe_highlight" states="draft" string="Export" type="object"/>
                        <button name="post" class="oe_highlight" states="export" string="Validate" type="object"/>
                        <button name="action_draft" states="cancel" string="Set To Draft" type="object"/>
                        <!--<button name="export" states="export,post" string="Export" type="object"/>-->
                        <button name="action_cancel" states="export,post" string="Cancel" type="object"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,export,sent,post"/>
                    </header>
                    <sheet>
                        <field name="id" invisible="1"/>
                        <div class="oe_title" attrs="{'invisible': [('state', '=', 'draft')]}">
                            <h1><field name="name"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="journal_id"/>
                                <field name="date"/>
                            </group>
                            <group>
                                <field name="currency_id" invisible="1"/>
                                <field name="amount"/>
                                <field name="export_file" readonly="1" filename="export_filename"/>
                                <field name="export_filename" invisible="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Payment">
                                <field name="line_ids">
                                    <tree string="Payment lines" editable="bottom" create="false" edit="false">
                                        <field name="payment_id" force_save="1"/>
                                        <field name="partner_id" force_save="1"/>
                                        <field name="partner_bank_id" options="{'no_create': True, 'no_open': True}"
                                               attrs="{'readonly': [('parent.state', '!=', 'draft')]}"/>
                                        <field name="currency_id" force_save="1" invisible="1"/>
                                        <field name="description" force_save="1"/>
                                        <field name="amount" force_save="1"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <!--<div class="oe_chatter">
                      <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
                      <field name="message_ids" widget="mail_thread"/>
                  </div>-->
                </form>
            </field>
        </record>
        <record id="view_payment_bank_batch_export_wizard" model="ir.ui.view">
            <field name="name">payment.bank.batch.form</field>
            <field name="model">payment.bank.batch</field>
            <field name="priority" eval="100"/>
            <field name="arch" type="xml">
                <form string="Payment Batch Export">
                    <sheet>
                        <group>
                            <group>
                                <field name="state" invisible="1"/>
                                <field name="journal_id" readonly="1"/>
                                <field name="date" readonly="1"/>
                            </group>
                            <!--<group>
                                <field name="export_file" readonly="1" filename="export_filename"/>
                                <field name="export_filename" invisible="1" />
                            </group>-->
                        </group>
                    </sheet>
                    <footer>
                        <button string="Export" name="export_confirm" type="object" class="btn-primary" states="draft"/>
                        <button string="Cancel" class="btn-default" special="cancel" states="draft"/>
                        <!--<button string="Ok" class="btn-default" special="cancel" states="export,post"/>-->
                    </footer>
                </form>
            </field>
        </record>
        <record id="action_payment_bank_batch" model="ir.actions.act_window">
            <field name="name">Batch Payments</field>
            <field name="res_model">payment.bank.batch</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree,form</field>
            <field eval="False" name="view_id"/>
            <!--<field name="view_id" ref="view_payment_journal_payable_tree"/>-->
            <!--<field name="search_view_id" ref="view_payment_bank_batch_search"/>-->
            <!--<field name="context">{'default_payment_type': 'outbound', 'default_partner_type': 'supplier', 'search_default_payable_filter': 1}</field>
            <field name="domain">[('payment_type','=','outbound')]</field>-->
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                  Click to register a batch payment
                </p><p>
                  Payments are used to register liquidity movements (send, collect or transfer money).
                  You can then process those payments by your own means or by using installed facilities.
                </p>
            </field>
        </record>
        <record id="action_payment_bank_batch_tree" model="ir.actions.act_window.view">
            <field eval="1" name="sequence"/>
            <field name="view_mode">tree</field>
            <field name="view_id" ref="view_payment_bank_batch_tree"/>
            <field name="act_window_id" ref="action_payment_bank_batch"/>
        </record>
        <record id="action_payment_bank_batch_form" model="ir.actions.act_window.view">
            <field eval="2" name="sequence"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_payment_bank_batch_form"/>
            <field name="act_window_id" ref="action_payment_bank_batch"/>
        </record>
        <menuitem action="action_payment_bank_batch" id="menu_action_payment_bank_batch" parent="account.menu_finance_payables_documents" sequence="21"/>
    </data>
</odoo>