<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="view_order_type_tree" model="ir.ui.view">
            <field name="name">crm.order.type.view</field>
            <field name="model">crm.order.type</field>
            <field name="type">tree</field>
            <field name="arch" type="xml">
                <tree string="Order Type" editable="bottom">
                    <field name="name"/>
                    <field name="proj_type_id" options="{'no_create': True}"/>
                    <field name="jenis_so"/>
                    <field name="boq_due"/>
                    <field name="need_spk"/>
                    <field name="using_mitra"/>
                    <field name="is_rental"/>
                    <field name="overhead_pct"/>
                </tree>
            </field>
        </record>

        <record model="ir.actions.act_window" id="act_order_type">
            <field name="name">Order Type</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">crm.order.type</field>
            <!-- <field name="view_type">form</field> -->
            <field name="view_mode">tree</field>
            <!--<field name="search_view_id" ref="view_work_unit_search"/>-->
            <field name="domain">[]</field>
            <field name="context">{}</field>
        </record>

        <!--<record model="ir.actions.act_window.view" id="act_open_work_unit_view_form">
            <field name="act_window_id" ref="act_open_work_unit_view"/>
            <field name="sequence" eval="20"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_work_unit_form"/>
        </record>

        <record model="ir.actions.act_window.view" id="act_open_work_unit_view_tree">
            <field name="act_window_id" ref="act_open_work_unit_view"/>
            <field name="sequence" eval="10"/>
            <field name="view_mode">tree</field>
            <field name="view_id" ref="view_work_unit_tree"/>
        </record>-->

        <menuitem id="menu_order_type"
                  parent="crm.menu_crm_config_lead"
                  sequence="50"
                  action="act_order_type"/>
    </data>
</odoo>
