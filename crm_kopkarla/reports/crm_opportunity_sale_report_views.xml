<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <record id="tree_opportunity_sale_report_view" model="ir.ui.view">
            <field name="name">tree.opportunity.sale.report.view</field>
            <field name="model">crm.opportunity.sale.report</field>
            <field name="arch" type="xml">
                <tree string="Opportunity to Sale Report">
                    <field name="sale_order_id"/>
                    <field name="partner_id"/>
                    <field name="order_date"/>
                    <field name="confirmation_date"/>
                    <field name="with_po"/>
                    <field name="reva_id"/>
                    <field name="price_subtotal" sum="sub_total"/>
                    <field name="invoice_draft" sum="sub_total"/>
                    <field name="invoice_open" sum="sub_total"/>
                    <field name="invoice_paid" sum="sub_total"/>
                    <field name="crm_id"/>
                    <field name="order_type_id"/>
                    <field name="proj_type_id"/>
                    <field name="user_id"/>
                    <field name="area_id"/>
                    <field name="order_state"/>
                </tree>
            </field>
        </record>

        <record id="form_opportunity_sale_report_view" model="ir.ui.view">
            <field name="name">form.opportunity.sale.report.view</field>
            <field name="model">crm.opportunity.sale.report</field>
            <field name="arch" type="xml">
                <form string="Bank account">
                    <sheet string="Opportunity to Sales Order">
                        <!--<div class="oe_title">
                            <label for="sale_order_id" class="oe_edit_only"/>
                            <h1>
                                <field name="sale_order_id"/>
                            </h1>
                        </div>-->
                        <group>
                            <group colspan="2">
                                <field name="partner_id"/>
                                <field name="order_type_id"/>
                                <field name="proj_type_id"/>
                                <field name="area_id"/>
                            </group>
                            <group>
                                <field name="sale_order_id"/>
                                <field name="order_date"/>
                                <field name="confirmation_date"/>
                                <field name="with_po"/>
                                <field name="reva_id"/>
                                <field name="order_state"/>
                                <field name="price_subtotal"/>
                            </group>
                            <group>
                                <field name="crm_id"/>
                                <field name="date_deadline"/>
                                <field name="total_revenue"/>
                                <field name="stage_id"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="pivot_opportunity_sale_report_view" model="ir.ui.view">
            <field name="name">pivot.opportunity.sale.report.view</field>
            <field name="model">crm.opportunity.sale.report</field>
            <field name="arch" type="xml">
                <pivot string="Opportunity to Sale Report" disable_linking="True">
                    <field name="order_type_id" type="col"/>
                    <field name="order_date" interval="month" type="row"/>
                    <field name="price_subtotal" type="measure"/>
                </pivot>
            </field>
        </record>

        <!--<record id="crm_opportunity_sale_report_view_graph" model="ir.ui.view">
            <field name="name">crm.opportunity.sale.report.graph</field>
            <field name="model">crm.opportunity.sale.report</field>
            <field name="arch" type="xml">
                <graph string="Pipeline Sales Analysis" stacked="True">
                    <field name="stage_id" type="row"/>
                    <field name="date_deadline" type="row" interval="month"/>
                    <field name="expected_revenue" type="measure"/>
                </graph>
            </field>
        </record>-->

