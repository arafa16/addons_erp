<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="enhanced_purchase_tnc_purchase_order_form">
            <field name="name">enhanced.purchase.tnc.purchase.order.form</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='notes']" position="before">
                    <field name="template_tnc"/>
                    <div class="oe_clear"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>