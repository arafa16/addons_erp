<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="sequence_asset_reclass" model="ir.sequence">
            <field name="name">Account asset reclass sequence</field>
            <field name="code">account.asset.reclass.sequence</field>
            <field name="prefix">RCLS</field>
            <field eval="1" name="number_next"/>
            <field eval="1" name="number_increment"/>
            <field eval="False" name="company_id"/>
            <field name="padding">5</field>
        </record>
        <record id="sequence_asset_reval" model="ir.sequence">
            <field name="name">Account asset revaluation sequence</field>
            <field name="code">account.asset.reclass.sequence</field>
            <field name="prefix">RVAL</field>
            <field eval="1" name="number_next"/>
            <field eval="1" name="number_increment"/>
            <field eval="False" name="company_id"/>
            <field name="padding">5</field>
        </record>
    </data>
</odoo>