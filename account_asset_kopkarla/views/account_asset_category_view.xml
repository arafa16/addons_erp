                            <label for="account_depreciation_expense_id" string="Depreciation Account" attrs="{'invisible': [('type','!=','purchase')]}"/>
                            <label for="account_depreciation_expense_id" string="Recognition Account" attrs="{'invisible': [('type','!=','sale')]}"/>
                        </div>
