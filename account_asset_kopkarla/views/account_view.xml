<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_move_line_inherit" model="ir.ui.view">
            <field name="name">account.move.line.inherit</field>
            <field name="model">account.move.line</field>
            <field name="inherit_id" ref="account.view_move_line_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='invoice_id']" position="after">
                    <field name="user_type_id"/>
                    <field name="asset_id"/>
                </xpath>
            </field>
        </record>
        <record id="view_move_asset_depre_form" model="ir.ui.view">
            <field name="name">account.move.asset.depre.form</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <field name="credit" position="after">
                    <field name="depre_lines" attrs="{'invisible': True}"/>
                </field>
            </field>
        </record>
    </data>
</odoo>
