<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="report_account_move_document">
            <t t-call="web.external_layout">
                <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)" />
                <div class="page">
                    <div class="row">
                        <h3 class="text-center">
                            <div>Journal Voucher</div>
                            <span t-field="o.name"/>
                        </h3>
                    </div>
                    <div class="row mt32 mb32" style="padding-left:20px;">
                        <table style="width:100%;">
                            <tr height="30px">
                                <td>Date</td><td>:</td><td><span t-field="o.date" t-field-options='{"format": "dd-MMM-yyyy"}'/></td>
                                <td style="width:100px"/>
                                <td>Journal Type</td><td style="width:10px">:</td><td><t t-esc="o.journal_id.name"/></td>
                            </tr>
                            <tr>
                                <td>Reference</td><td style="width:10px">:</td><td><t t-esc="o.ref"/></td>
                                <td/>
                                <td></td><td></td><td></td>
                            </tr>
                        </table>
                    </div>
                    <div style="padding-top:30px;">
                        <table class="table table-condensed" name="payment_journal_line_table">
                            <thead>
                                <tr>
                                    <th>Account</th>
                                    <th>Label</th>
                                    <!--<th>Cost Center</th>
                                    <th>Analytic Account</th>-->
                                    <th class="text-right">Debit</th>
                                    <th class="text-right">Credit</th>
                                </tr>
                            </thead>
                            <tbody class="invoice_tbody">
                                <t t-set="debit" t-value="0"/>
                                <t t-set="credit" t-value="0"/>
                                <tr t-foreach="o.line_ids" t-as="l">
                                    <td><span t-field="l.account_id"/></td>
                                    <td><span t-field="l.name"/></td>
                                    <!--<td><span t-field="l.cost_center_id.name"/></td>
                                    <td><span t-field="l.analytic_account_id.name"/></td>-->
                                    <td class="text-right"><t t-set="debit" t-value="debit+l.debit"/><span t-field="l.debit" t-field-options='{"widget": "monetary", "display_currency": "l.currency_id"}'/></td>
                                    <td class="text-right"><t t-set="credit" t-value="credit+l.credit"/><span t-field="l.credit" t-field-options='{"widget": "monetary", "display_currency": "l.currency_id"}'/></td>
                                </tr>
                                <tr style="font-weight:bold;">
                                    <td>&amp;nbsp;</td>
                                    <td></td>
                                    <!--<td></td>
                                    <td class="text-right">Total</td>-->
                                    <td class="text-right"><span t-esc="debit" t-options='{"widget": "monetary", "display_currency": "o.currency_id"}'/></td>
                                    <td class="text-right"><span t-esc="credit" t-options='{"widget": "monetary", "display_currency": "o.currency_id"}'/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div style="padding-top:50px; page-break-inside: avoid;">
                        <table class="table" style="widht:100%;height:200px;border: 1px solid black">
                            <tr class="border-black" style="height:25px;">
                                <td width="25%" style="border: 1px solid">Prepared by,</td>
                                <td width="25%" style="border: 1px solid">Approved by,</td>
                            </tr>
                            <tr class="border-black">
                                <td style="border: 1px solid"></td>
                                <td style="border: 1px solid"></td>
                            </tr>
                        </table>
                    </div>
                </div>
            </t>
        </template>

        <template id="account_move_report_template">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="account_kopkarla.report_account_move_document" t-lang="o.partner_id.lang"/>
                </t>
            </t>
        </template>
    </data>
</odoo>
