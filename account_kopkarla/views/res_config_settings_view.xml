<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="25"/>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='group_cash_rounding']/../.." position="after">
                <div class="col-xs-12 col-md-6 o_setting_box">
                    <div class="o_setting_left_pane">
                        <field name="mandatory_faktur"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="mandatory_faktur"/>
                        <div class="text-muted">
                            Set faktur number and date as mandatory.
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-md-6 o_setting_box">
                    <div class="o_setting_right_pane">
                        <label for="default_bank_transfer_to_id"/>
                        <div class="text-muted">
                            Set default bank destination of customer payment.
                        </div>
                        <div class="text-muted">
                            <field name="default_bank_transfer_to_id"/>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-md-6 o_setting_box">
                    <div class="o_setting_right_pane">
                        <label for="default_sign_by_id"/>
                        <div class="text-muted">
                            Set default employee sign by of customer invoice.
                        </div>
                        <div class="text-muted">
                            <field name="default_sign_by_id" options="{'no_create': True, 'no_open': True}"/>
                        </div>
                    </div>
                </div>
            </xpath>
            <xpath expr="//div[@data-key='account_invoicing']" position="inside">
                <h2>Under &amp; Over Payment</h2>
                <div class="row mt16 o_settings_container">
                    <div class="col-xs-12 col-md-6 o_setting_box" title="Account for under payment.">
                        <div class="o_setting_right_pane">
                            <label string="Under Payment Default Account" for="under_payment_account"/>
                            <div class="text-muted">
                                Default account for under payment or received payment
                            </div>
                            <div class="text-muted">
                                <field name="under_payment_account"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-md-6 o_setting_box" title="Account for over payment.">
                       <div class="o_setting_right_pane">
                            <label string="Over Payment Default Account" for="over_payment_account"/>
                            <div class="text-muted">
                                Default account for over received payment
                            </div>
                            <div class="text-muted">
                                <field name="over_payment_account"/>
                            </div>
                        </div>
                    </div>
                </div>
                <h2>Default Signer for Payment Journal</h2>
                <div class="row mt16 o_settings_container">
                    <div class="col-xs-12 col-md-6 o_setting_box" title="Sign By">
                        <div class="o_setting_right_pane">
                            <label string="Default pembuat" for="default_created_sign_by"/>
                            <div class="text-muted">
                                Dibuat
                            </div>
                            <div class="text-muted">
                                <field name="default_created_sign_by" options="{'no_create': True, 'no_open': True}"/>
                            </div>
                        </div>
                        <div class="o_setting_right_pane">
                            <label string="Default approval" for="default_known_sign_by"/>
                            <div class="text-muted">
                                Mengetahui
                            </div>
                            <div class="text-muted">
                                <field name="default_known_sign_by" options="{'no_create': True, 'no_open': True}"/>
                            </div>
                        </div>
                        <div class="o_setting_right_pane">
                            <label string="Default pengurus" for="default_management_sign_by"/>
                            <div class="text-muted">
                                Pengurus
                            </div>
                            <div class="text-muted">
                                <field name="default_management_sign_by" options="{'no_create': True, 'no_open': True}"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-md-6 o_setting_box" title="Account for over payment.">
                        <div class="o_setting_right_pane">
                            <label string="Default pemeriksa" for="default_checked_sign_by"/>
                            <div class="text-muted">
                                Pemeriksa
                            </div>
                            <div class="text-muted">
                                <field name="default_checked_sign_by" options="{'no_create': True, 'no_open': True}"/>
                            </div>
                        </div>
                        <div class="o_setting_right_pane">
                            <label string="Default pelaksana" for="default_done_sign_by"/>
                            <div class="text-muted">
                                Pelaksana
                            </div>
                            <div class="text-muted">
                                <field name="default_done_sign_by" options="{'no_create': True, 'no_open': True}"/>
                            </div>
                        </div>
                    </div>
                </div>
                <h2>Default Signer for Ledger Journal</h2>
                <div class="row mt16 o_settings_container">
                    <div class="col-xs-12 col-md-6 o_setting_box" title="Sign By">
                        <div class="o_setting_right_pane">
                            <label string="Default Prepaired By" for="default_journal_prepair_by"/>
                            <div class="text-muted">
                                Prepare
                            </div>
                            <div class="text-muted">
                                <field name="default_journal_prepair_by" options="{'no_create': True, 'no_open': True}"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-md-6 o_setting_box" title="Account for over payment.">
                        <div class="o_setting_right_pane">
                            <label string="Default Approved By" for="default_journal_approve_by"/>
                            <div class="text-muted">
                                Approve
                            </div>
                            <div class="text-muted">
                                <field name="default_journal_approve_by" options="{'no_create': True, 'no_open': True}"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
