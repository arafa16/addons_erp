<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="report_payment_voucher_document">
            <t t-call="web.external_layout">
                <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)" />
                <div class="page">
                    <div class="row">
                        <h3 class="text-center">
                            <div>Payment Voucher</div>
                        </h3>
                    </div>
                    <div class="row mt32 mb32" style="padding-left:20px;">
                        <table style="width:100%;">
                            <tr height="30px">
                                <td style="width:120px">Document No.</td><td style="width:20px">:</td><td><t t-esc="o.name"/></td>
                                <td style="width:200px"/>
                                <td style="width:120px">Paid To</td><td style="width:20px">:</td><td><t t-esc="o.partner_id.name"/></td>
                            </tr>
                        </table>
                    </div>
                    <div style="padding-top:10px;">
                        <table class="table table-condensed" name="payment_journal_line_table">
                            <thead>
                                <tr>
                                    <th>Account</th>
                                    <th>Name</th>
                                    <th>Description</th>
                                    <th class="text-right">Amount</th>
                                </tr>
                            </thead>
                            <tbody class="invoice_tbody">
                                <tr>
                                    <td><span t-field="o.partner_id.property_account_payable_id.code"/></td>
                                    <td><span t-field="o.partner_id.property_account_payable_id.name"/></td>
                                    <td><span t-esc="o.paymend_invoice_desc()"/></td>
                                    <td class="text-right"><span t-field="o.amount" t-field-options='{"widget": "monetary", "display_currency": "o.currency_id"}'/></td>
                                </tr>
                                <tr>
                                    <td><span t-field="o.journal_id.default_credit_account_id.code"/></td>
                                    <td><span t-field="o.journal_id.default_credit_account_id.name"/></td>
                                    <td><span t-esc="o.paymend_invoice_desc()"/></td>
                                    <td class="text-right">-<span t-field="o.amount" t-field-options='{"widget": "monetary", "display_currency": "o.currency_id"}'/></td>
                                </tr>
                                <tr style="font-weight: bold;">
                                    <td></td>
                                    <td></td>
                                    <td class="text-right">Total</td>
                                    <td class="text-right">0</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div style="padding-top:100px;">
                        <table class="table" style="widht:100%;height:200px;border: 1px solid black">
                            <tr class="border-black" style="height:25px;">
                                <td width="25%">Prepared by,</td>
                                <td width="25%" style="border: 1px solid">Checked by,</td>
                                <td width="25%" style="border: 1px solid">Approved by,</td>
                                <td width="25%">Remark</td>
                            </tr>
                            <!--<tr class="border-black" style="height:25px;">
                                <td>Finance Staff</td>
                                <td style="border: 1px solid">Department Head</td>
                                <td style="border: 1px solid">Division Head</td>
                                <td></td>
                            </tr>
                            <tr class="border-black" style="height:25px;">
                                <td></td>
                                <td style="border: 1px solid"></td>
                                <td style="border: 1px solid"></td>
                                <td></td>
                            </tr>
                            <tr class="border-black" style="height:25px;">
                                <td></td>
                                <td style="border: 1px solid"></td>
                                <td style="border: 1px solid"></td>
                                <td></td>
                            </tr>-->
                            <tr class="border-black">
                                <td></td>
                                <td style="border: 1px solid"></td>
                                <td style="border: 1px solid"></td>
                                <td></td>
                            </tr>
                        </table>
                    </div>
                </div>
            </t>
        </template>

        <template id="payment_voucher_report_template">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="account_kopkarla.report_payment_voucher_document" t-lang="o.partner_id.lang"/>
                </t>
            </t>
        </template>
    </data>
</odoo>
