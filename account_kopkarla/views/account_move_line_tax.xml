<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_account_move_line_tax_tree" model="ir.ui.view">
            <field name="name">account.move.line.tax.tree</field>
            <!--<field name="model">account.move.line.tax</field>-->
            <field name="model">account.move.line</field>
            <field name="arch" type="xml">
                <tree string="Tax Report" editable="bottom" create="false" delete="false">
                    <field name="name" invisible="1"/>
                    <field name="tax_line_id" string="Tax" readonly="1"/>
                    <field name="date" readonly="1"/>
                    <field name="move_id" readonly="1"/>
                    <field name="journal_id" invisible="1"/>
                    <field name="ref" readonly="1"/>
                    <field name="invoice_id" readonly="1"/>
                    <field name="payment_id" string="Payment" readonly="1"/>
                    <field name="account_id" readonly="1"/>
                    <field name="user_type_id" invisible="1"/>
                    <field name="tax_no"/>
                    <field name="tax_date"/>
                    <field name="tax_base_amount"/>
                    <field name="debit" invisible="1"/>
                    <field name="credit" invisible="1"/>
                    <field name="balance" string="Tax Amount"/>
                </tree>
            </field>
        </record>
        <record id="view_account_move_line_tax_form" model="ir.ui.view">
            <field name="name">account.move.line.tax.form</field>
            <!--<field name="model">account.move.line.tax</field>-->
            <field name="model">account.move.line</field>
            <field name="arch" type="xml">
                <form string="Tax Information">
                    <header>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="tax_line_id" readonly="1"/>
                                <field name="date" readonly="1"/>
                                <field name="tax_base_amount" readonly="1"/>
                                <field name="balance" readonly="1"/>
                            </group>
                            <group>
                                <field name="tax_no"/>
                                <field name="tax_date"/>
                            </group>
                        </group>
                    </sheet>
                    <!--<div class="oe_chatter">
                      <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
                      <field name="message_ids" widget="mail_thread"/>
                  </div>-->
                </form>
            </field>
        </record>
        <record id="action_account_move_line_tax_report" model="ir.actions.act_window">
            <field name="name">Tax Report</field>
            <!--<field name="res_model">account.move.line.tax</field>-->
            <field name="res_model">account.move.line</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree</field>
            <field name="view_id" eval="False"/>
            <!--<field name="domain">[('tax_line_id', '!=', False)]</field>-->
            <field name="domain">[('account_id.show_tax_report', '=', True)]</field>
        </record>
        <record model="ir.actions.act_window.view" id="action_account_move_line_tax_report_tree">
            <field name="sequence" eval="1"/>
            <field name="view_mode">tree</field>
            <field name="view_id" ref="view_account_move_line_tax_tree"/>
            <field name="act_window_id" ref="action_account_move_line_tax_report"/>
        </record>
        <record model="ir.actions.act_window.view" id="action_account_move_line_tax_report_form">
            <field name="sequence" eval="2"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_account_move_line_tax_form"/>
            <field name="act_window_id" ref="action_account_move_line_tax_report"/>
        </record>
        <menuitem action="action_account_move_line_tax_report" id="menu_account_move_line_tax_report"
                  parent="account.account_reports_management_menu" sequence="31"
                  groups="account.group_account_user"/>
    </data>
</odoo>
