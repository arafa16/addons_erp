<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="assets_common" name="account_kopkarla" inherit_id="web.minimal_layout">
            <xpath expr="." position="inside">
                <link rel="stylesheet" href="/account_kopkarla/static/src/css/report.css"/>
            </xpath>
        </template>

        <template id="report_invoice_propose_payment">
            <t t-call="web.external_layout">
                <h3><center>
                    <span>Payment Proposal</span><br/>
                    <span t-field="o.number"/>
                </center></h3>
                <div class="row mt32 mb32" style="padding-left:20px;">
                    <table style="width:100%;">
                        <tr>
                            <td style="width:49%;">
                                <table style="width:100%;">
                                    <tr height="22px">
                                        <td style="width:150px">Invoice Date</td><td style="width:16px">:</td><td><span t-field="o.date_invoice"/></td>
                                    </tr>
                                    <tr height="22px">
                                        <td>Vendor</td><td>:</td><td><t t-esc="o.partner_id.name"/></td>
                                    </tr>
                                </table>
                            </td>
                            <td style="width:8%;"/>
                            <td style="width:43%;">
                                <table>
                                    <tr height="22px">
                                        <td style="width:150px">No Invoice</td><td style="width:16px">:</td><td><t t-esc="o.reference"/></td>
                                    </tr>
                                    <tr height="22px">
                                        <td>No PO</td><td>:</td><td><span t-field="o.origin"/><span t-field="o.purch_id_info"/></td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>
                </div>
                <div style="border-top: 2px solid;"/>
                <table class="table table-condensed" name="invoice_line_table">
                    <thead>
                        <tr style="border-bottom: 2px solid;">
                            <th>Account</th>
                            <th>Nama Barang</th>
                            <th class="hidden">Source Document</th>
                            <th class="text-right">Quantity</th>
                            <th class="text-right">Harga Sat.</th>
                            <th t-if="display_discount" class="text-right">Disc.(%)</th>
                            <th class="text-right">Pajak</th>
                            <th class="text-right">Sub Total</th>
                        </tr>
                        <tr t-if="o.name">
                            <th colspan="8"><span t-field="o.name"/></th>
                        </tr>
                    </thead>
                    <tbody class="invoice_tbody">
                        <tr t-foreach="o.invoice_line_ids" t-as="l">
                            <td style="font-size: 11px;"><span t-field="l.account_id.code"/><br/><span t-field="l.account_id.name"/></td>
                            <td style="font-size: 11px;"><span t-field="l.name"/></td>
                            <td class="hidden"><span t-field="l.origin"/></td>
                            <td class="text-right" style="font-size: 11px;">
                                <span t-field="l.quantity"/>
                                <span t-field="l.uom_id"  groups="product.group_uom"/>
                            </td>
                            <td class="text-right" style="font-size: 11px;">
                                <span t-field="l.price_unit"/>
                            </td>
                            <td t-if="display_discount" class="text-right" style="font-size: 11px;">
                                <span t-field="l.discount"/>
                            </td>
                            <td class="text-right" style="font-size: 11px;">
                                <span t-esc="', '.join(map(lambda x: (x.description or x.name), l.invoice_line_tax_ids))"/>
                            </td>
                            <td class="text-right" id="subtotal" style="font-size: 11px;">
                                <span t-field="l.price_subtotal"
                                    t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                            </td>
                        </tr>
                        <tr t-foreach="range(max(2-len(o.invoice_line_ids),0))" t-as="l">
                            <td t-translation="off">&amp;nbsp;</td>
                            <td class="hidden"></td>
                            <td></td>
                            <td></td>
                            <td t-if="display_discount"></td>
                            <td></td>
                            <td></td>
                            <td></td>
                        </tr>
                    </tbody>
                </table>

                <!--<div class="footer" style="height: 300px;">-->
                <div style="height: 400px; page-break-inside: avoid;">
                    <div class="text-center" style="border-top: 1px solid black;">
                        <p t-if='o.text_amount' style="text-align: left; width: 100%;">
                            <strong>Terbilang:</strong>
                            <span t-field="o.text_amount"/>
                        </p>
                        <div>
                            <table style="width:100%;">
                                <tr>
                                    <td style="width:49%;">
                                        <table style="width: 100%;">
                                            <tr style="height: 30px;">
                                                <td></td>
                                                <td></td>
                                                <td></td>
                                            </tr>
                                            <tr style="height: 28px;">
                                                <td></td>
                                                <td></td>
                                                <td></td>
                                            </tr>
                                            <tr style="height: 25px;">
                                                <td style="padding-left:10px; padding-top:5px; padding-bottom:5px;width: 20%"><strong>Tax</strong></td>
                                                <td>:</td>
                                                <td/>
                                            </tr>
                                            <tr style="height: 25px; border-bottom: 2px solid black">
                                                <td style="padding-left:10px; padding-top:5px; padding-bottom:5px;width: 20%"><strong>Nominal</strong></td>
                                                <td>:</td>
                                                <td/>
                                            </tr>
                                        </table>
                                    </td>
                                    <td style="width:2%;"/>
                                    <td style="width:49%;">
                                        <table style="width: 100%;">
                                            <tr>
                                                <td style="padding-left:10px; padding-top:10px; padding-bottom:5px; width: 60%">Total sebelum pajak</td>
                                                <td>:</td>
                                                <td class="text-right" style="padding-right:10px;">
                                                    <span t-field="o.amount_untaxed" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                                </td>
                                            </tr>
                                            <t t-set="tax_exist" t-value="0"/>
                                            <t t-foreach="o._get_tax_amount_by_group()" t-as="amount_by_group">
                                                <t t-set="tax_exist" t-value="1"/>
                                                <t t-if="len(o.tax_line_ids) == 1 and o.amount_untaxed == amount_by_group[2]">
                                                    <tr>
                                                        <td style="padding-left:10px; padding-top:5px; padding-bottom:5px;"><span t-esc="amount_by_group[0]"/></td>
                                                        <td>:</td>
                                                        <td class="text-right" style="padding-right:10px;">
                                                            <span t-esc="amount_by_group[3]" />
                                                        </td>
                                                    </tr>
                                                    <tr style="height: 25px;">
                                                        <td></td>
                                                        <td></td>
                                                        <td></td>
                                                    </tr>
                                                </t>
                                                <t t-else="">
                                                    <tr>
                                                        <td style="padding-left:10px; padding-top:5px; padding-bottom:5px;">
                                                            <span t-esc="amount_by_group[0]"/>
                                                            <span>&amp;nbsp;<span>on</span>
                                                                <t t-esc="amount_by_group[4]"/>
                                                            </span>
                                                        </td>
                                                        <td>:</td>
                                                        <td class="text-right" style="padding-right:10px;">
                                                            <span t-esc="amount_by_group[3]"/>
                                                        </td>
                                                    </tr>
                                                </t>
                                            </t>
                                            <t t-if="tax_exist == 0">
                                                <tr style="height: 25px;">
                                                    <td></td>
                                                    <td></td>
                                                    <td></td>
                                                </tr>
                                                <tr style="height: 25px;">
                                                    <td></td>
                                                    <td></td>
                                                    <td></td>
                                                </tr>
                                            </t>
                                            <tr style="border-top: 2px solid #dddddd; border-bottom: 2px solid black;">
                                                <td style="padding-left:10px; padding-top:5px; padding-bottom:5px;"><strong>Total yang harus dibayar</strong></td>
                                                <td>:</td>
                                                <td class="text-right" style="padding-right:10px;">
                                                    <span t-field="o.amount_total" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                    <div style="padding-top:30px;">
                        <table class="table" style="widht:100%;height:175px;border: 1px solid black">
                            <tr class="border-black" style="height:25px;">
                                <td width="20%">Dibuat,</td>
                                <td width="20%" style="border: 1px solid">Diperiksa,</td>
                                <td width="20%" style="border: 1px solid">Disetujui,</td>
                                <td width="20%" style="border: 1px solid">Mengetahui,</td>
                                <!--<td width="20%" style="border: 1px solid">Dilaksanakan,</td>-->
                                <td width="20%">Pengurus,</td>
                            </tr>
                            <tr class="border-black">
                                <td style="font-size: 10px; text-align: center; vertical-align: bottom;"><span t-field="o.created_sign_by.user_id.signature"/><span t-field="o.created_sign_by"/></td>
                                <td style="font-size: 10px; text-align: center; vertical-align: bottom; border-left: 1px solid"><span t-field="o.checked_sign_by.user_id.signature"/><span t-field="o.checked_sign_by"/></td>
                                <td style="font-size: 10px; text-align: center; vertical-align: bottom; border-left: 1px solid"><span t-field="o.disetujui_sign_by.user_id.signature"/><span t-field="o.disetujui_sign_by"/></td>
                                <td style="font-size: 10px; text-align: center; vertical-align: bottom; border-left: 1px solid"><span t-field="o.known_sign_by.user_id.signature"/><span t-field="o.known_sign_by"/></td>
                                <!--<td style="font-size: 10px; text-align: center; vertical-align: bottom; border-left: 1px solid"><span t-field="o.done_sign_by.user_id.signature"/><span t-field="o.done_sign_by"/></td>-->
                                <td style="font-size: 10px; text-align: center; vertical-align: bottom; border-left: 1px solid"><span t-field="o.management_sign_by.user_id.signature"/><span t-field="o.management_sign_by"/></td>
                            </tr>
                            <tr class="border-black" style="height:30px;">
                                <td style="text-align: left; vertical-align: bottom;">Tanggal:</td>
                                <td style="text-align: left; vertical-align: bottom; border: 1px solid">Tanggal:</td>
                                <td style="text-align: left; vertical-align: bottom; border: 1px solid">Tanggal:</td>
                                <td style="text-align: left; vertical-align: bottom; border: 1px solid">Tanggal:</td>
                                <td style="text-align: left; vertical-align: bottom;">Tanggal:</td>
                            </tr>
                        </table>
                        <!--<div class="col-xs-3" style="padding:0px;">
                            <table class="table" style="height:175px;border: 1px solid black">
                                <tr class="border-black" style="height:25px;">
                                    <td width="33.5%" style="padding-left:5px;padding-top:3px;">Pengurus,</td>
                                </tr>
                                <tr class="border-black">
                                    <td style="text-align: center; vertical-align: bottom;"><span t-field="o.management_sign_by"/></td>
                                </tr>
                                <tr class="border-black" style="height:30px;">
                                    <td style="text-align: left; vertical-align: bottom;">Tanggal:</td>
                                </tr>
                            </table>
                        </div>-->
                    </div>
                </div>
                <div class="footer">
                    <div name="owner_footer" class="text-center" style="padding-top: 30px;">
                        <table width="100%">
                            <tr><td class="text-center"><strong>KOPERASI KONSUMEN KARYAWAN PT. APLIKANUSA LINTASARTA</strong></td></tr>
                            <tr><td class="text-center">Gedung KOPKARLA, Jalan Lebak Bulus Raya No. 7, Lebak Bulus, Cilandak, Jakarta Selatan 12440</td></tr>
                            <tr><td class="text-center">Telepon 021 - 7590 9425, Fax 021 - 2920 3466</td></tr>

                        </table>
                    </div>
                    <!--<ul class="list-inline mb4">
                        <li t-if="company.phone">Phone: <span t-field="company.phone"/></li>
                        <li t-if="company.email">Email: <span t-field="company.email"/></li>
                        <li t-if="company.website">Web: <span t-field="company.website"/></li>
                        <li t-if="company.vat"><t t-esc="company.country_id.vat_label or 'TIN'"/>: <span t-field="company.vat"/></li>
                    </ul>-->

                    <div name="financial_infos">
                        <span t-field="company.report_footer"/>
                    </div>
                </div>
            </t>
        </template>

        <template id="report_invoice_to_pay">
            <t t-call="web.html_container">
                <t t-set="company" t-value="res_company"/>
                <t t-foreach="docs" t-as="o">
                    <t t-call="account_kopkarla.report_invoice_propose_payment" t-lang="o.partner_id.lang"/>
                </t>
            </t>
        </template>

        <report
            id="account_invoices_to_pay"
            model="account.invoice"
            string="Payment Proposal"
            report_type="qweb-pdf"
            name="account_kopkarla.report_invoice_to_pay"
            file="account_kopkarla.report_invoice_to_pay"
            attachment="(object.state in ('open','paid')) and ('INV'+(object.number or '').replace('/','')+'.pdf')"
            print_report_name="(object._get_printed_report_name())"
            groups="account.group_account_invoice"
            menu="False"
        />

        <!--<record id="account.account_invoices" model="ir.actions.report">
            <field name="paperformat_id" ref="account_kopkarla.invoice" />
        </record>-->
    </data>
</odoo>
