<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_payment_receipt" inherit_id="account.report_payment_receipt">
        <xpath expr="//div[hasclass('page')]" position="replace">
            <h3><center><strong>Internal Transfer Voucher<div t-field="o.name"/></strong></center></h3>
            <div class="row mt64">
                <div class="col-xs-6" t-if="o.payment_date">
                    <strong>Payment Journal: </strong> <span t-field="o.journal_id"/>
                </div>
                <div class="col-xs-6" t-if="o.payment_date">
                    <strong>Payment Date: </strong> <span t-field="o.payment_date"/>
                </div>
            </div>
            <!--<div class="row">
                <div class="col-xs-6" t-if="o.partner_type">
                    <t t-if="o.partner_type == 'customer'">
                        <strong>Customer: </strong>
                    </t>
                    <t t-if="o.partner_type == 'supplier'">
                        <strong>Vendor: </strong>
                    </t><span t-field="o.partner_id"/>
                </div>
                <div class="col-xs-6" t-if="o.payment_method_id">
                    <strong>Payment Method: </strong><span t-field="o.payment_method_id.name"/>
                </div>
            </div>-->
            <div class="row mb64">
                <div class="col-xs-6" t-if="o.destination_journal_id">
                    <strong>Transfer To: </strong><span t-field="o.destination_journal_id"/>
                 </div>
                <div class="col-xs-6" t-if="o.communication">
                    <strong>Memo: </strong><span t-field="o.communication"/>
                 </div>
            </div>
            <div class="row mb64">
                <div class="col-xs-6" t-if="o.amount">
                    <strong>Payment Amount: </strong><span t-field="o.amount" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                 </div>
            </div>
            <!--<table class="table table-condensed">
                <thead>
                    <tr>
                        <th>Invoice Date</th>
                        <th>Invoice Number</th>
                        <th class="text-right">Original Amount</th>
                        <th class="text-right">Amount Paid</th>
                        <th class="text-right">Balance</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="o.invoice_ids" t-as="inv">
                        <td><span t-field="inv.date_invoice"/></td>
                        <td><span t-field="inv.number"/></td>
                        <td class="text-right"><span t-field="inv.amount_total"/></td>
                        <td class="text-right"><span t-esc="o._get_invoice_payment_amount(inv)" t-options="{'widget': 'monetary', 'display_currency': inv.currency_id}"/></td>
                        <td class="text-right"><span t-field="inv.residual"/></td>
                    </tr>
                </tbody>
            </table>-->
            <div style="height: 400px; page-break-inside: avoid;">
                <div style="padding-top:30px;">
                    <table class="table" style="widht:100%;height:175px;border: 1px solid black">
                        <tr class="border-black" style="height:25px;">
                            <td width="25%">Dibuat,</td>
                            <td width="25%" style="border: 1px solid">Diperiksa,</td>
                            <td width="25%" style="border: 1px solid">Disetujui,</td>
                            <td width="25%">Mengetahui,</td>
                        </tr>
                        <tr class="border-black">
                            <td style="text-align: center; vertical-align: bottom;"><span t-field="o.created_sign_by"/></td>
                            <td style="text-align: center; vertical-align: bottom; border: 1px solid"><span t-field="o.checked_sign_by"/></td>
                            <td style="text-align: center; vertical-align: bottom; border: 1px solid"><span t-field="o.disetujui_sign_by"/></td>
                            <td style="text-align: center; vertical-align: bottom;"><span t-field="o.known_sign_by"/></td>
                        </tr>
                    </table>
                    <div class="col-xs-3" style="padding:0px;">
                        <table style="widht:33.5%;height:175px;border: 1px solid black">
                            <tr style="height:25px;">
                                <td width="33.5%" style="padding-left:5px;padding-top:3px;">Pengurus,</td>
                            </tr>
                            <tr class="border-black">
                                <td style="text-align: center; vertical-align: bottom;"><span t-field="o.management_sign_by"/></td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
        </xpath>
