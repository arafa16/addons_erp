<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="sprogroup_purchase_request_buyer_receive_tree">
            <field name="name">sprogroup.purchase.request.buyer.receive.tree</field>
            <field name="model">sprogroup.purchase.request</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="namex"/>
                    <field name="tanggal_procure"/>
                    <field name="date_start"/>
                    <field name="requested_by"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <record model="ir.actions.act_window" id="sprogroup_purchase_request_buyer_receive_action">
            <field name="name">Purchase Request Buyer Received</field>
            <field name="res_model">sprogroup.purchase.request</field>
            <field name="view_type">form</field>
            <field name="context">{"search_default_state":"done"}</field>
            <field name="domain">[('state', 'in', ['loader_approved','done'])]</field>
            <field name="view_id" ref="sprogroup_purchase_request_buyer_receive_tree"/>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem 
            id="sprogroup_purchase_request_buyer_receive_menu"
            name="Buyer Received"
            parent="purchase.menu_procurement_management"
            sequence="4"
            action="sprogroup_purchase_request_buyer_receive_action"
        />
    </data>
</odoo>