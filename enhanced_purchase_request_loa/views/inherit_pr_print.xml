                    </div>
                    <div style=" text-align:center;width:300px;">
                        (  <span style="text-decoration:underline; font-weight:bold; "><span t-field="doc.penandatangan5"/></span> )
                    </div>
                </div>
            </xpath>
            <xpath expr="//td[@name='tempatcoa']" position="inside">
                <span t-field="doc.account_id"/>
            </xpath>
        </template>
