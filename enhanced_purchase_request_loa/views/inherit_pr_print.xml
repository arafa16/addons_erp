                <div t-if="doc.required1" class="col-xs-3">
                    <div style="padding-bottom:90px; text-align:center;">
                        Asisten Manager
                    </div>
                    <div style=" text-align:center;width:300px;">
                        (  <span style="text-decoration:underline; font-weight:bold; "><span t-field="doc.penandatangan1"/></span> )
                    </div>
                </div>
                <div t-if="doc.required2" class="col-xs-3">
                    <div style="padding-bottom:90px; text-align:center;">
                        Manager
                    </div>
                    <div style=" text-align:center;width:300px;">
                        (  <span style="text-decoration:underline; font-weight:bold; "><span t-field="doc.penandatangan2"/></span> )
                    </div>
                </div>
                <div t-if="doc.required3" class="col-xs-3">
                    <div style="padding-bottom:90px; text-align:center;">
