<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_bill_quantity_tree" model="ir.ui.view">
            <field name="name">bill.quantity.tree</field>
            <field name="model">bill.quantity</field>
            <field name="type">tree</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <tree string="Bill Of Quantity">
                    <field name="name"/>
                    <!--<field name="revision"/>-->
                    <field name="crm_id"/>
                    <field name="order_type_id"/>
                    <field name="total_cost"/>
                    <field name="total_sale"/>
                    <field name="user_id"/>
                    <field name="rfi_expired_date"/>
                    <field name="boq_rfi_expired"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <record id="view_bill_quantity_form" model="ir.ui.view">
            <field name="name">bill.quantity.form</field>
            <field name="model">bill.quantity</field>
            <field name="type">form</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <form string="Bill Of Quantity">
                    <header>
                        <!--<button string="New Revision" type="object"
                                name="create_new_revision"/>-->
                        <field name="allow_post" invisible="1"/>
                        <field name="allow_cancel" invisible="1"/>
                        <button name="action_draft" string="Set to Draft" states="cancel" class="btn-primary" type="object"/>
                        <button name="action_to_rfi" string="To RFI" class="btn-primary" type="object" attrs="{'invisible': [('allow_to_rfi','=',False)]}"/>
                        <button name="action_calculation" string="Calculation" class="btn-primary" type="object" attrs="{'invisible': [('allow_calculation','=',False)]}"/>
                        <button name="action_approval" string="Approval" class="btn-primary" type="object" attrs="{'invisible': [('state','!=','calculation')]}"/>
                        <button name="action_post" string="Post" class="btn-primary" type="object" attrs="{'invisible': [('allow_post','=',False)]}"/>
                        <button name="action_cancel" string="Cancel" type="object" attrs="{'invisible': [('allow_cancel','=',False)]}"/>
                        <!--<field name="state" widget="statusbar" statusbar_visible="draft,to_rfi,posted"/>-->
                        <field name="state" widget="statusbar" statusbar_visible="draft,to_rfi,calculation,approval,posted"/>
                    </header>
                    <sheet string="Bill Of Quantity">
                        <div class="oe_button_box" name="button_box">
                            <button class="oe_stat_button" type="object" context="{'bill_quantity_id': id, 'key': 'material'}" name="action_show_boq_material" icon="fa-bars">
                                <div class="o_stat_info">
                                    <field name="line_material_count" class="o_stat_value"/>
                                    <span class="o_stat_text" attrs="{'invisible': [('line_material_count', '&lt;', 2)]}"> Materials</span>
                                    <span class="o_stat_text" attrs="{'invisible': [('line_material_count', '&gt;', 1)]}"> Material</span>
                                </div>
                            </button>
                            <button class="oe_stat_button" type="object" context="{'bill_quantity_id': id, 'key': 'operational'}" name="action_show_boq_operational" icon="fa-bars">
                                <div class="o_stat_info">
                                    <field name="line_operational_count" class="o_stat_value"/>
                                    <span class="o_stat_text" attrs="{'invisible': [('line_operational_count', '&lt;', 2)]}"> Operationals</span>
                                    <span class="o_stat_text" attrs="{'invisible': [('line_operational_count', '&gt;', 1)]}"> Operational</span>
                                </div>
                            </button>
                            <button class="oe_stat_button" type="object" context="{'bill_quantity_id': id, 'key': 'permit'}" name="action_show_boq_permit" icon="fa-bars">
                                <div class="o_stat_info">
                                    <field name="line_permit_count" class="o_stat_value"/>
                                    <span class="o_stat_text" attrs="{'invisible': [('line_permit_count', '&lt;', 2)]}"> Permits</span>
                                    <span class="o_stat_text" attrs="{'invisible': [('line_permit_count', '&gt;', 1)]}"> Permit</span>
                                </div>
                            </button>
                            <button class="oe_stat_button" type="object" context="{'bill_quantity_id': id, 'key': 'mitra'}"
                                    name="action_show_boq_mitra" icon="fa-bars" attrs="{'invisible': [('using_mitra', '!=', True)]}">
                                <div class="o_stat_info">
                                    <field name="line_mitra_count" class="o_stat_value"/>
                                    <span class="o_stat_text" attrs="{'invisible': [('line_mitra_count', '&lt;', 2)]}"> Mitras</span>
                                    <span class="o_stat_text" attrs="{'invisible': [('line_mitra_count', '&gt;', 1)]}"> Mitra</span>
                                </div>
                            </button>
                            <button class="oe_stat_button" type="object" context="{'bill_quantity_id': id, 'key': 'asset'}"
                                    name="action_show_boq_asset" icon="fa-bars" attrs="{'invisible': ['|', ('is_rental', '=', False), ('rental_type', '=', 'Back to Back')]}">
                                <div class="o_stat_info">
                                    <field name="line_asset_count" class="o_stat_value"/>
                                    <span class="o_stat_text" attrs="{'invisible': [('line_asset_count', '&lt;', 2)]}"> Assets</span>
                                    <span class="o_stat_text" attrs="{'invisible': [('line_asset_count', '&gt;', 1)]}"> Asset</span>
                                </div>
                            </button>
                            <!--<button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive" attrs="{'invisible': [('active', '=', True), ('probability', '&lt;', 100)]}">
                                <field name="active" widget="boolean_button" options="{&quot;terminology&quot;: &quot;archive&quot;}"/>
                            </button>-->
                        </div>
                        <group>
                            <div class="oe_title">
                                <h1>
                                    <field name="name" class="oe_inline" readonly="1"/>
                                           <!--attrs="{'readonly':[('state','!=','draft'),('state','!=','to_rfi')]}"/>-->
                                    <span attrs="{'invisible': [('revision', '=', 0)]}"> Rev.
                                        <field name="revision" class="oe_inline"/>
                                    </span>
                                </h1>
                            </div>
                        </group>
                        <group>
                            <group>
                                <field name="allow_cancel" invisible="1"/>
                                <field name="allow_to_rfi" invisible="1"/>
                                <field name="allow_calculation" invisible="1"/>
                                <label for="crm_id"/>
                                <div name="crm_id">
                                    <field name="crm_id" select="1" required="1" class="oe_inline" options="{'no_create': True}"/>
                                    (Stage: <field name="crm_stage_id" readonly="1" class="oe_inline"/>)
                                </div>
                                <!--<field name="subcontract_cost"/>-->
                                <field name="partner_id" readonly="1"/>
                                <field name="date"/>
                                <field name="boq_due_date" readonly="1"/>
                                <field name="rfi_due_date"/>
                                <field name="rfi_expired_date" force_save="1"/>
                                <field name="create_date" readonly="1"/>
                                <field name="close_date" readonly="1" attrs="{'invisible': [('state', '!=', 'posted')]}"/>
                            </group>
                            <group>
                                <field name="user_id" readonly="1"/>
                                <field name="order_type_id" readonly="1"/>
                                <field name="is_rental" invisible="1"/>
                                <field name="rental_type" readonly="0" attrs="{'invisible': [('is_rental', '=', False)]}"/>
                                <label for="rental_period" attrs="{'invisible': [('is_rental', '=', False)]}"/>
                                <div attrs="{'invisible': [('is_rental', '=', False)]}">
                                    <field name="rental_period" class="oe_inline" style="padding-right: 5px;"/>
                                    <field name="rental_uom_id" widget="selection" class="oe_inline"/>
                                </div>
                                <field name="cost_center_id" readonly="1"/>
                                <field name="area_id" invisible="1"/>
                                <field name="analytic_account_id" readonly="1"/>
                            </group>
                            <group string="Cost Calculation">
                                <field string="Material" name="material_cost" class="oe_right" readonly="1"/>
                                <field string="Operational" name="operational_cost" class="oe_right" readonly="1"/>
                                <field string="Permit" name="permit_cost" class="oe_right" readonly="1"/>
                                <field string="Mitra" name="mitra_cost" class="oe_right" readonly="1"/>
                                <label for="disc_mitra_cost_pct" attrs="{'invisible': [('using_mitra','=',False)]}"/>
                                <div attrs="{'invisible': [('using_mitra','=',False)]}">
                                    <field name="disc_mitra_cost_pct" class="oe_inline"/>%
                                    <field name="disc_mitra_cost_amt" class="oe_inline oe_right" readonly="1" force_save="1"/>
                                </div>

                                <label for="overhead_pct" string="Overhead"/>
                                <div>
                                    <field name="overhead_pct" class="oe_inline" attrs="{'readonly': [('state', '=', 'posted')]}"/>%
                                    <field name="overhead_amount" class="oe_inline oe_right" readonly="1"/>
                                </div>


                                <field string="Total" name="total_cost" style="font-weight: bold;" class="oe_right" readonly="1"/>
                            </group>
                            <group string="Sales Calculation">
                                <field string="Material" name="material_sale" class="oe_right" readonly="1"/>
                                <field string="RV" name="resalas_amount" class="oe_right" attrs="{'invisible': [('is_rental', '=', False)]}"/>
                                <!--<field string="Operational" name="operational_cost" class="oe_right" readonly="1"/>-->
                                <!--<field string="Permit" name="permit_cost" class="oe_right" readonly="1"/>-->
                                <field string="Mitra" name="mitra_sale" class="oe_right" readonly="1" attrs="{'invisible': [('using_mitra','=',False)]}"/>
                                <label for="disc_mitra_sale_pct" attrs="{'invisible': [('using_mitra','=',False)]}"/>
                                <div attrs="{'invisible': [('using_mitra','=',False)]}">
                                    <field name="disc_mitra_sale_pct" class="oe_inline"/>%
                                    <field name="disc_mitra_sale_amt" class="oe_inline oe_right" readonly="1" force_save="1"/>
                                </div>
                                <field string="Total" name="total_sale" style="font-weight: bold;" class="oe_right" readonly="1"/>
                            </group>
                            <group string="Margin">
                                <field string="Amount" name="margin_amount" style="font-weight: bold;" class="oe_right" readonly="1"/>
                                <field string="Percent" name="margin_pct" style="font-weight: bold;" class="oe_right" readonly="1"/>
                            </group>
                            <group colspan="2">
                                <field string="Notes" name="notes"/>
                            </group>
                        </group>
                        <notebook colspan="4">
                            <field name="using_mitra" invisible="1"/>
                            <field name="is_rental" invisible="1"/>
                            <page string="Materials" name="material">
                                <field name="line_material_ids" context="{'default_key': 'material'}">
                                    <!--<tree string="Quantity Line" decoration-info="state=='done'" decoration-muted="state=='cancel'">-->
                                    <tree string="Quantity Line">
                                        <field name="key" invisible="1" force_save="1"/>
                                        <!--<field name="state" invisible="1"/>-->
                                        <!--<field name="employee_id"/>-->
                                        <!--<field name="assest_id"/>-->
                                        <!--<field name="partner_id"/>-->
                                        <!--<field name="work_package_id"/>-->
                                        <field name="product_id" options="{'no_create': True}"/>
                                        <!--<field name="type"/>-->
                                        <field name="name"/>
                                        <field name="product_brand"/>
                                        <field name="product_type"/>
                                        <field name="qty"/>
                                        <field name="uom_id" options="{'no_create': True}"/>
                                        <field name="price_unit" style="background-color: #89fae7;"/>
                                        <field name="price_subtotal" style="background-color: #89fae7;" sum="Total Cost"/>
                                        <field name="sale_price" style="background-color: #f1fc88;"/>
                                        <field name="sale_subtotal" style="background-color: #f1fc88;" sum="Total Sales"/>
                                        <field name="revenue_margin"/>
                                        <field name="lokasi_kirim"/>
                                        <field name="expired_date" invisible="1"/>
                                        <field name="delivery"/>
                                        <field name="franco"/>
                                        <field name="payment_term_id" invisible="1"/>
                                        <field name="garansi"/>
                                        <field name="rfi_id" invisible="1"/>
                                        <field name="rfi_send"/>
                                        <field name="state"/>
                                        <field name="count_attachment"/>
                                        <field name="bill_quantity_id" invisible="1"/>
                                        <field name="allow_set_vendor" invisible="1"/>
                                        <!--<button name="%(action_bill_quantity_select_vendor)d" string="Set" type="action"
                                                context="{'default_bill_quantity_line_id': id}"
                                                attrs="{'invisible': [('parent.state','=','posted')]}"/>-->
                                        <button name="show_bill_quantity_select_vendor" string="Set" type="object"
                                                attrs="{'invisible': [('parent.state','=','posted')]}"/>
                                    </tree>
                                    <form string="Quantity Line">
                                        <header>
                                            <field name="state" invisible="1" widget="statusbar" statusbar_visible="draft,done"/>
                                        </header>
                                        <sheet string="BoQ Line">
                                            <group> <!--attrs="{'invisible': [('state','=','done'),('rfi_send','!=',False)]}">-->
                                                <group attrs="{'invisible': [('parent.using_mitra', '=', True)]}">
                                                    <field name="rfi_send" attrs="{'readonly': [('state','=','done')]}"/>
                                                </group>
                                                <group attrs="{'invisible': [('parent.using_mitra', '=', True)]}">
                                                    <field name="user_rfq_id" readonly="1"/>
                                                </group>
                                                <group colspan="2" attrs="{'invisible': [('state', '!=', 'reject')]}" style="background-color: #fcacac;">
                                                    <field name="reject_reason" readonly="1"/>
                                                </group>
                                                <group>
                                                    <field name="key" invisible="1" force_save="1"/>
                                                    <!--<field name="assest_id"-->
                                                    <!--<field name="employee_id" attrs="{'invisible': [('key','!=', 'labor')]}"/>-->
                                                    <!--attrs="{'invisible': [('key','!=', 'equipment')]}"/>-->
                                                    <!--<field name="partner_id" attrs="{'invisible': [('key','!=', 'subcontract')]}"/>-->
                                                    <!--<field name="work_package_id" attrs="{'invisible': [('key','!=', 'work_package')]}"/>-->
                                                    <field name="product_id" options="{'no_create': True}" attrs="{'readonly': [('state','=','done')]}"/> <!--attrs="{'invisible': [('key','!=', 'material')]}"/>-->
                                                    <field name="product_brand" attrs="{'readonly': [('state','=','done')]}"/>
                                                    <field name="product_type" attrs="{'readonly': [('state','=','done')]}"/>
                                                    <field name="name" attrs="{'readonly': [('state','=','done')]}"/>
                                                </group>
                                                <group>
                                                    <!--<field name="type"/>-->
                                                    <field name="qty" attrs="{'readonly': [('state','=','done')]}"/>
                                                    <field name="uom_id" options="{'no_create': True}" attrs="{'readonly': [('state','=','done')]}"/>
                                                    <field name="price_unit" attrs="{'readonly': ['|',('rfi_send','=',True),('state','=','done')]}"/>
                                                    <field name="price_subtotal" sum="Total Cost"/>
                                                </group>
                                                <group>
                                                    <field name="lokasi_kirim"/>
                                                    <field name="expired_date"/>
                                                    <field name="delivery"/>
                                                    <field name="franco"/>
                                                    <field name="payment_term_id"/>
                                                    <field name="garansi"/>
                                                    <label for="count_attachment" string="Attachment"/>
                                                    <div>
                                                        <field name="count_attachment" class="oe_inline" style="padding-right: 10px;"/>
                                                        <button name="action_view_employee_attachment" icon="fa-eye" type="object" class="oe_inline"/>
                                                    </div>
                                                </group>
                                                <group>
                                                    <field name="sale_price" force_save="1" attrs="{'readonly': [('allow_set_sales','!=',True)]}"/>
                                                    <field name="sale_subtotal" force_save="1" sum="Total Sales"/>
                                                    <field name="allow_set_sales" invisible="1"/>
                                                    <field name="revenue_margin"/>
                                                </group>
                                            </group>
                                            <!--<notebook attrs="{'invisible': ['|',('state','!=','done'),('rfi_send','=',False)]}">
                                                <page string="Select Vendor" name="price">
                                                    <field name="product_rfi_ids" string="Select Vendor">
                                                        <tree string="Select Vendor" create="false" editable="bottom" delete="false">
                                                            <button name="action_select_vendor" string="Sel" type="object"/>
                                                            <field name="selected" string="Sel"/>
                                                            <field name="product_id" options="{'no_create': True, 'no_open': True}" invisible="1"/>
                                                            &lt;!&ndash;<field name="type"/>&ndash;&gt;
                                                            &lt;!&ndash;<field name="uom_id" options="{'no_create': True, 'no_open': True}"/>&ndash;&gt;
                                                            <field name="partner_id" options="{'no_create': True, 'no_open': True}" domain="[('supplier','=',True)]"/>
                                                            <field name="price_unit"/>
                                                            <field name="create_date"/>
                                                            <field name="expired_date"/>
                                                            <field name="delivery"/>
                                                            <field name="franco"/>
                                                            <field name="garansi"/>
                                                            <field name="payment_term_id"/>
                                                            <field name="name"/>
                                                        </tree>
                                                        &lt;!&ndash;<form string="Select Vendor">
                                                            <sheet string="Select Vendor">
                                                                <group>
                                                                    <group>
                                                                        <field name="partner_id" options="{'no_create': True, 'no_open': True}" domain="[('supplier','=',True)]"/>
                                                                    </group>
                                                                </group>
                                                            </sheet>
                                                            <footer>
                                                                <button name="action_select_vendor" type="object" string="Process" class="btn-primary"/>
                                                            </footer>
                                                        </form>&ndash;&gt;
                                                    </field>
                                                </page>
                                                &lt;!&ndash;<page string="Selected Vendor" name="selected_vendor">
                                                    <group>
                                                        <field name="rfi_id" options="{'no_create': True}" domain="[('bill_quantity_line_id', '=', active_id)]"/>
                                                        <field name="price_unit" readonly="1" force_save="1"/>
                                                        <field name="rfi_expired_date" readonly="1"/>
                                                    </group>
                                                </page>&ndash;&gt;
                                            </notebook>-->
                                        </sheet>
                                        <!--<footer>
                                            <button name="action_close" string="Close" class="btn-default" type="object"/>
                                            <button special="cancel" string="Cancel" class="btn-default"/>
                                        </footer>-->
                                    </form>
                                </field>
                            </page>
                            <page string="Asset" name="asset" attrs="{'invisible': ['|', ('is_rental', '=', False), ('rental_type', '=', 'Back to Back')]}">
                                <field name="line_asset_ids" context="{'default_key': 'asset'}">
                                    <tree string="Quantity Line" editable="bottom">
                                        <field name="key" invisible="1" force_save="1"/>
                                        <field name="asset_id" options="{'no_create': True}"/>
                                        <field name="name"/>
                                        <!--<field name="qty"/>-->
                                        <!--<field name="uom_id" options="{'no_create': True}"/>-->
                                        <!--<field name="price_unit"/>
                                        <field name="price_service"/>
                                        <field name="price_subtotal" sum="Total Cost Mitra"/>
                                        <field name="service_subtotal" sum="Total Service Mitra"/>
                                        <field name="sale_price" readonly="1" force_save="1"/>
                                        <field name="sale_service" readonly="1" force_save="1"/>
                                        <field name="sale_subtotal" sum="Total Sales"/>
                                        <field name="sale_service_subtotal" sum="Total Service Sales"/>
                                        <field name="revenue_margin"/>-->
                                    </tree>
                                    <form string="Quantity Line">
                                        <group>
                                            <group>
                                                <field name="key" invisible="1" force_save="1"/>
                                                <!--<field name="work_package_id" options="{'no_create': True}"/>--> <!--attrs="{'invisible': [('key','!=', 'material')]}"/>-->
                                                <field name="asset_id" options="{'no_create': True}"/> <!--attrs="{'invisible': [('key','!=', 'material')]}"/>-->
                                                <field name="name"/>
                                            </group>
                                            <group>
                                                <field name="qty"/>
                                                <field name="uom_id" options="{'no_create': True}"/>
                                                <field name="price_unit"/>
                                                <field name="price_subtotal" sum="Total Cost"/>
                                            </group>
                                            <!--<group>
                                                <field name="lokasi_kirim"/>
                                                <field name="garansi"/>
                                            </group>
                                            <group>
                                                <field name="sale_price"/>
                                                <field name="sale_subtotal" sum="Total Sales"/>
                                                <field name="revenue_margin"/>
                                            </group>-->
                                        </group>
                                    </form>
                                </field>
                            </page>
                            <page string="Operationals" name="operational">
                                <field name="line_operational_ids" context="{'default_key': 'operational'}">
                                    <tree string="Quantity Line" editable="bottom">
                                        <field name="key" invisible="1" force_save="1"/>
                                        <field name="cost_code_id" domain="[('key', '=', 'operational'),'|',('area_id', '=', parent.area_id),('price_unit', '=', 0)]" context="{'default_key': 'operational'}" options="{'no_create': True}"/>
                                        <field name="name"/>
                                        <field name="qty"/>
                                        <field name="uom_id" options="{'no_create': True}"/>
                                        <field name="price_unit"/>
                                        <field name="price_subtotal" sum="Total Operational"/>
                                    </tree>
                                    <form string="Quantity Line">
                                        <group>
                                            <group>
                                                <field name="key" invisible="1" force_save="1"/>
                                                <!--<field name="work_package_id" options="{'no_create': True}"/>--> <!--attrs="{'invisible': [('key','!=', 'material')]}"/>-->
                                                <field name="cost_code_id" options="{'no_create': True}"/> <!--attrs="{'invisible': [('key','!=', 'material')]}"/>-->
                                                <field name="name"/>
                                            </group>
                                            <group>
                                                <field name="qty"/>
                                                <field name="uom_id" options="{'no_create': True}"/>
                                                <field name="price_unit"/>
                                                <field name="price_subtotal" sum="Total Cost"/>
                                            </group>
                                            <!--<group>
                                                <field name="lokasi_kirim"/>
                                                <field name="garansi"/>
                                            </group>
                                            <group>
                                                <field name="sale_price"/>
                                                <field name="sale_subtotal" sum="Total Sales"/>
                                                <field name="revenue_margin"/>
                                            </group>-->
                                        </group>
                                    </form>
                                </field>
                            </page>
                            <page string="Permits" name="permit">
                                <field name="line_permit_ids" context="{'default_key': 'permit'}">
                                    <tree string="Quantity Line" editable="bottom">
                                        <field name="key" invisible="1" force_save="1"/>
                                        <!--<field name="employee_id"/>-->
                                        <!--<field name="assest_id"/>-->
                                        <!--<field name="partner_id"/>-->
                                        <!--<field name="work_package_id" domain="[('key', '=', 'permit')]" context="{'default_key': 'permit'}"/>-->
                                        <field name="cost_code_id" domain="[('key', '=', 'permit'),('area_id', '=', parent.area_id)]" context="{'default_key': 'permit'}" options="{'no_create': True}"/>
                                        <!--<field name="product_id" options="{'no_create': True, 'no_open': True}"/>-->
                                        <!--<field name="type"/>-->
                                        <!--<field name="product_brand"/>
                                        <field name="product_type"/>-->
                                        <field name="name"/>
                                        <field name="qty"/>
                                        <field name="uom_id" options="{'no_create': True}"/>
                                        <field name="price_unit"/>
                                        <field name="price_subtotal" sum="Total Permit"/>
                                        <!--<field name="lokasi_kirim"/>
                                        <field name="garansi"/>-->
                                    </tree>
                                    <form string="Quantity Line">
                                        <group>
                                            <group>
                                                <field name="key" invisible="1" force_save="1"/>
                                                <!--<field name="work_package_id" options="{'no_create': True}"/>--> <!--attrs="{'invisible': [('key','!=', 'material')]}"/>-->
                                                <field name="cost_code_id" options="{'no_create': True}"/> <!--attrs="{'invisible': [('key','!=', 'material')]}"/>-->
                                                <field name="name"/>
                                            </group>
                                            <group>
                                                <field name="qty"/>
                                                <field name="uom_id" options="{'no_create': True}"/>
                                                <field name="price_unit"/>
                                                <field name="price_subtotal" sum="Total Cost"/>
                                            </group>
                                            <!--<group>
                                                <field name="lokasi_kirim"/>
                                                <field name="garansi"/>
                                            </group>
