<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_order_tree_boq" model="ir.ui.view">
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_tree"/>
            <field name="arch" type="xml">
                <field name="amount_total" position="after">
                    <field name="boq_id"/>
                </field>
            </field>
        </record>

        <record id="view_order_form_boq" model="ir.ui.view">
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <div name="button_box" position="inside">
                    <button name="action_view_boq"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-pencil-square-o"
                        attrs="{'invisible': [('boq_id', '=', False)]}">
                        <field name="boq_id" widget="statinfo" string="BoQ"/>
                    </button>
                </div>
            </field>
        </record>

        <record id="view_quotation_tree_boq" model="ir.ui.view">
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_quotation_tree"/>
            <field name="arch" type="xml">
                <field name="amount_total" position="after">
                    <field name="boq_id"/>
                </field>
            </field>
        </record>

        <record id="view_sales_order_filter_boq" model="ir.ui.view">
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_sales_order_filter"/>
            <field name="arch" type="xml">
                <field name="product_id" position="after">
                    <field name="boq_id"/>
                </field>
                <filter name="message_needaction" position="before">
                    <filter string="Ada BoQ" name="ada_boq" domain="[('boq_id','!=',False)]"/>
                    <filter string="Tidak Ada BoQ" name="tidak_ada_boq" domain="[('boq_id','=',False)]"/>
                    <separator/>
                </filter>
            </field>
        </record>
    </data>
</odoo>