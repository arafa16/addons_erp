            <field name="name">cost.code.tree</field>
            <field name="model">cost.code</field>
            <field name="type">tree</field>
            <!--<field name="priority" eval="8"/>-->
            <field name="arch" type="xml">
                <tree string="Cost Code" editable="bottom">
                    <field name="key"/>
                    <field name="cost_header_id"/>
                    <!--<field name="number"/>-->
                    <field name="name"/>
                    <field name="area_id"/>
                    <!--<field name="description"/>-->
                    <!--<field name="qty"/>-->
                    <field name="uom_id"/>
                    <field name="price_unit"/>
                    <field name="price_service"/>
                    <field name="sale_unit"/>
                    <field name="sale_service"/>
                    <!--<field name="sub_total"/>-->
                </tree>
            </field>
        </record>

