        <record id="view_bill_quantity_rfi_history_search" model="ir.ui.view">
            <field name="name">bill.quantity.history.search</field>
            <field name="model">bill.quantity.rfi</field>
            <field name="type">search</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <search string="Product Price History">
                    <field name="product_id" select="True"/>
                </search>
            </field>
        </record>

        <record model="ir.actions.act_window" id="act_open_bill_quantity_rfi_history">
            <field name="name">Product Price History</field>
            <field name="res_model">bill.quantity.rfi</field>
            <!-- <field name="view_type">form</field> -->
            <field name="view_mode">tree</field>
            <field name="search_view_id" ref="view_bill_quantity_rfi_history_search"/>
            <field name="domain">[]</field>
            <field name="context">{}</field>
        </record>

