<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_rfi_drill_tree" model="ir.ui.view">
            <field name="name">bill.quantity.rfi.drill.form</field>
            <field name="model">bill.quantity.rfi</field>
            <field name="type">form</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <form create="false" write="false" delete="false">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" class="oe_inline" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="create_date" readonly="1"/>
                                <field name="bill_quantity_id" readonly="1"/>
                                <field name="crm_id" readonly="1"/>
                                <field name="product_id" readonly="1"/>
                                <field name="description" readonly="1"/>
                            </group>
                            <group>
                                <field name="partner_id"/>
                                <field name="price_unit"/>
                                <field name="payment_term_id"/>
                                <field name="expired_date"/>
                                <field name="franco"/>
                                <field name="delivery"/>
                                <field name="garansi"/>
                            </group>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="view_rfi_tree" model="ir.ui.view">
            <field name="name">bill.quantity.rfi.tree</field>
            <field name="model">bill.quantity.line</field>
            <field name="type">tree</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <tree string="RFI">
                    <field name="key"/>
                    <field name="bill_quantity_id"/>
                    <field name="crm_id"/>
                    <field name="product_id"/>
                    <field name="cost_code_id"/>
                    <field name="name"/>
                    <field name="qty"/>
                    <field name="price_unit"/>
                    <field name="rfi_send"/>
                    <field name="user_rfq_id" groups="bill_of_quantity_kopkarla.group_rfi_manager"/>
                    <field name="rfi_id"/>
                    <field name="rfi_expired_date"/>
                    <field name="rfi_expired"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <record id="view_rfi_form" model="ir.ui.view">
            <field name="name">bill.quantity.rfi.form</field>
            <field name="model">bill.quantity.line</field>
            <field name="type">form</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <form string="RFI">
                    <header>
                        <button name="action_draft" string="Set to Draft" states="reject,cancel" class="btn-primary" type="object"/>
                        <button name="action_process" string="Process" states="draft" class="btn-primary" type="object"/>
                        <button name="action_post" string="Post" states="process" class="btn-primary" type="object"/>
                        <button name="action_rfi_send" states="draft,process" string="Send RFI" type="object"/>
                        <!--<button name="action_reject" string="Reject" states="draft,process" type="object"/>-->
                        <button name="%(action_bill_quantity_reject)d" string="Reject" states="draft,process" type="action" context="{'default_bill_quantity_line_id': id}"/>
                        <button name="action_cancel" string="Cancel" states="process,done" type="object"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,process,done"/>
                    </header>
                    <sheet string="RFI">
                        <div class="oe_button_box" name="button_box">
                            <button class="oe_stat_button" name="show_rfi_product_price" type="object"
                                    attrs="{'invisible':[('product_price_count','=', 0)]}" icon="fa-money">
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_text" style="text-align: center;"><field name="product_price_count"/></span>
                                    <span class="o_stat_text">History</span>
                                </div>
                            </button>
                        </div>
                        <!--<group>
                            <div class="oe_title">
                                <h1>
                                    <field name="name" class="oe_inline"
                                           attrs="{'readonly':[('state','!=','draft'),('state','!=','to_rfi')]}"/>
                                    <span attrs="{'invisible': [('revision', '=', 0)]}"> Rev.
                                        <field name="revision" class="oe_inline"/>
                                    </span>
                                </h1>
                            </div>
                        </group>-->
                        <group>
                            <group>
                                <label for="bill_quantity_id"/>
                                <div name="bill_quantity_id">
                                    <field name="bill_quantity_id" readonly="1" class="oe_inline"/>
                                    (Status: <field name="boq_state" readonly="1" class="oe_inline"/>)
                                </div>
                                <label for="crm_id"/>
                                <div name="crm_id">
                                    <field name="crm_id" readonly="1" class="oe_inline"/>
                                    (Stage: <field name="crm_stage_id" readonly="1" class="oe_inline"/>)
                                </div>
                                <field name="product_id" readonly="1"/>
                                <label for="qty"/>
                                <div name="qty">
                                    <field name="qty" readonly="1" class="oe_inline"/>
                                    <field name="uom_id" readonly="1" class="oe_inline"/>
                                </div>
                                <field name="name" readonly="1"/>
                            </group>
                            <group>
                                <!--<field name="penawaran_harga" widget="radio" options="{'horizontal': true}"/>-->
                                <field name="boq_due_date" widget="date" readonly="1"/>
                                <field name="rfi_due_date" readonly="1"/>
                                <!--<field name="divisi" widget="radio" options="{'horizontal': true}"/>-->
                                <field name="alamat_pengiriman" readonly="1"/>
                                <field name="close_date" readonly="1" attrs="{'invisible': [('state', '!=', 'done')]}"/>
                            </group>
                            <group>
                                <field name="user_id" readonly="1"/>
                                <field name="user_rfq_id" options="{'no_create': True}" groups="bill_of_quantity_kopkarla.group_rfi_manager"/>
                            </group>
                            <group>
                                <field name="cost_center_id" readonly="1"/>
                                <field name="analytic_account_id" readonly="1"/>
                            </group>
                            <group>
                                <field name="rfi_id" readonly="1" options="{'no_create': True}" domain="[('bill_quantity_line_id', '=', active_id)]"/>
                                <field name="price_unit" readonly="1"/>
                                <field name="rfi_expired_date" readonly="1"/>
                            </group>
                        </group>
                        <notebook colspan="4">
                            <page string="Vendor Price" name="price">
                                <field name="product_rfi_ids">
                                    <tree string="Product Price" editable="bottom">
                                        <field name="product_id" options="{'no_create': True}" invisible="1"/>
                                        <!--<field name="type"/>-->
                                        <!--<field name="uom_id" options="{'no_create': True}"/>-->
                                        <field name="partner_id" options="{'no_create': True}" domain="[('supplier','=',True)]"/>
                                        <field name="price_unit"/>
                                        <field name="expired_date"/>
                                        <field name="delivery"/>
                                        <field name="franco"/>
                                        <field name="garansi"/>
                                        <field name="payment_term_id" options="{'no_create': True}"/>
                                        <field name="description"/>
                                        <field name="create_date" readonly="1"/>
                                    </tree>
                                    <form>
                                        <sheet>
                                            <group>
                                                <group>
                                                    <label for="name"/>
                                                    <div name="rfi">
                                                        <field name="name"/>
                                                        <button name="goto_rfi" type="object" string="[...]" class="oe_inline"/>
                                                    </div>
                                                    <field name="create_date"/>
                                                    <field name="bill_quantity_id"/>
                                                    <field name="crm_id"/>
                                                    <field name="description"/>
                                                    <field name="product_id"/>
                                                </group>
                                                <group>
                                                    <field name="partner_id"/>
                                                    <field name="price_unit"/>
                                                    <field name="payment_term_id"/>
                                                    <field name="expired_date"/>
                                                    <field name="franco"/>
                                                    <field name="delivery"/>
                                                    <field name="garansi"/>
                                                </group>
                                            </group>
                                        </sheet>
                                    </form>
                                </field>
                            </page>
                            <page string="Activity">
                                <field name="boq_line_activity_ids">
                                    <tree editable="bottom">
                                        <field name="notes"/>
                                        <field name="create_date" readonly="1"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="view_rfi_pivot" model="ir.ui.view">
            <field name="name">bill.quantity.line.pivot</field>
            <field name="model">bill.quantity.line</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <pivot string="RFI">
                    <field name="product_id" type="row"/>
                    <field name="rfi_due_date" interval="month" type="col"/>
                    <!--<field name="total_sale" type="measure"/>-->
                </pivot>
            </field>
        </record>

        <record id="view_bill_quantity_rfi_search" model="ir.ui.view">
            <field name="name">bill.quantity.search</field>
            <field name="model">bill.quantity.line</field>
            <field name="type">search</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <search string="RFI">
                    <field name="product_id" select="True"/>
                    <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                    <filter string="Process" name="process" domain="[('state','=','process')]"/>
                    <filter string="Done" name="done" domain="[('state','=','done')]"/>
                    <filter string="Rejected" name="reject" domain="[('state','=','reject')]"/>
                    <filter string="Canceled" name="cancel" domain="[('state','=','cancel')]"/>
                    <separator/>
                    <filter string="BoQ Draft" name="boq_draft" domain="[('boq_state','=','draft')]"/>
                    <filter string="BoQ To RFI" name="boq_to_rfi" domain="[('boq_state','=','to_rfi')]"/>
                    <filter string="BoQ Posted" name="boq_posted" domain="[('boq_state','=','posted')]"/>
                    <filter string="BoQ Canceled" name="boq_cancel" domain="[('boq_state','=','cancel')]"/>
                </search>
            </field>
        </record>

        <record model="ir.actions.act_window" id="act_open_bill_quantity_rfi">
            <field name="name">RFI</field>
            <field name="res_model">bill.quantity.line</field>
            <!-- <field name="view_type">form</field> -->
            <field name="view_mode">tree,form,pivot</field>
            <field name="search_view_id" ref="view_bill_quantity_rfi_search"/>
            <field name="domain">[('key', '=', 'material'),('rfi_send','=',True)]</field>
            <field name="context">{'search_default_boq_to_rfi': True, 'search_default_draft': True, 'search_default_process': True}</field>
        </record>

        <!--<record id="action_boq_new" model="ir.actions.act_window">
            <field name="name">BoQ</field>
            <field name="res_model">bill.quantity</field>
            <field name="view_mode">form,tree,graph</field>
            <field name="domain">[('crm_id', '=', active_id)]</field>
            <field name="context">{'search_default_crm_id': active_id, 'default_crm_id': active_id}</field>
        </record>-->

        <!--<record model="ir.actions.act_window.view" id="act_open_bill_quantity_view_form">
            <field name="act_window_id" ref="act_open_bill_quantity_view"/>
            <field name="sequence" eval="20"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_bill_quantity_form"/>
        </record>

        <record model="ir.actions.act_window.view" id="act_open_bill_quantity_view_tree">
            <field name="act_window_id" ref="act_open_bill_quantity_view"/>
            <field name="sequence" eval="10"/>
            <field name="view_mode">tree</field>
            <field name="view_id" ref="view_bill_quantity_tree"/>
        </record>-->

        <menuitem action="act_open_bill_quantity_rfi"
                  id="menu_bill_quantity_rfi"
                  sequence="15"
                  parent="purchase.menu_purchase_control"
                  groups="bill_of_quantity_kopkarla.group_rfi_manager,bill_of_quantity_kopkarla.group_rfi_officer"
        />
    </data>
</odoo>
