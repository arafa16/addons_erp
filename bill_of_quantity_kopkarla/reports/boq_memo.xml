                                    <td width="75%" class="text-left" style="padding: 0px 0px 0px 10px;"><span t-field="doc.crm_id.name"/></td>
                                </tr>
                                <tr height="22px">
                                    <td width="20%" class="text-left" style="padding: 0px 0px 0px 10px;">Customer</td>
                                    <td width="5%" class="text-left" style="padding: 0px 0px 0px 10px;">:</td>
                                    <td width="75%" class="text-left" style="padding: 0px 0px 0px 10px;"><span t-field="doc.partner_id.name"/></td>
                                </tr>
                                <tr height="22px">
