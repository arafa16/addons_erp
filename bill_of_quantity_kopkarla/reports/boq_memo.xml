                                </tr>
                                <tr>
                                    <td width="70%" class="text-left" style="padding: 0px 10px;">Percent</td>
                                    <td width="30%" class="text-right" style="padding: 0px 10px; border-left: 1px solid white;"><span t-esc="'{0:,.2f}%'.format(doc.margin_pct)"/></td>
                                </tr>
                                <tr>
                                    <td width="70%" class="text-left" style="padding: 0px 10px;">Masa Sewa</td>
                                    <td width="30%" class="text-right" style="padding: 0px 10px; border-left: 1px solid white;"><span t-esc="'%s %s' % (doc.rental_period, doc.rental_uom_id.name)"/></td>
                                </tr>
                            </table>
                        </span>
                    </p>
                    <p class="col-xs-12 text-center" style="background-color: lightgreen;">NOTE</p>
                    <p class="col-xs-12">
                        <span class="c"><span t-field="doc.notes"/></span>
