                                    <td width="30%" class="text-right" style="padding: 0px 10px; border-left: 1px solid lightgray;"><span t-esc="'{0:,.2f}'.format(doc.material_cost)"/></td>
                                </tr>
                                <t t-foreach="doc.line_operational_ids" t-as="line">
                                    <tr>
                                        <td width="70%" class="text-left" style="padding: 0px 0px 0px 10px;"><span t-field="line.name"/></td>
                                        <td width="30%" class="text-right" style="padding: 0px 10px; border-left: 1px solid lightgray;"><span t-esc="'{0:,.2f}'.format(line.price_subtotal)"/></td>
                                    </tr>
                                </t>
                                <!--<tr>
                                    <td width="70%" class="text-left" style="padding: 0px 0px 0px 10px;">BIAYA MITRA</td>
                                    <td width="30%" class="text-right" style="padding: 0px 10px; border-left: 1px solid lightgray;"><span t-esc="'{0:,.2f}'.format(doc.mitra_cost)"/></td>
                                </tr>
                                <tr>
                                    <td width="70%" class="text-left" style="padding: 0px 0px 0px 10px;">Overhead</td>
                                    <td width="30%" class="text-right" style="padding: 0px 10px; border-left: 1px solid lightgray;"><span t-esc="'{0:,.2f}'.format(doc.overhead_amount)"/></td>
                                </tr>-->
                                <tr style="font-weight: bold;">
                                    <td width="70%" class="text-right" style="padding: 0px 10px;">Total Biaya</td>
                                    <td width="30%" class="text-right" style="padding: 0px 10px; border-left: 1px solid white;"><span t-esc="'{0:,.2f}'.format(doc.total_cost)"/></td>
                                </tr>
                            </table>
                        </span>
                    </p>
                    <p class="col-xs-12">
                        <span class="c" style="padding: 0px 0px 0px 10px; font-weight: bold;"><u>REVENUE</u></span><br/>
                        <span class="c">
                            <table class="table">
                                <tr>
                                    <td width="70%" class="text-left" style="padding: 0px 0px 0px 10px;">Tagihan Sewa</td>
                                    <td width="30%" class="text-right" style="padding: 0px 10px; border-left: 1px solid lightgray;"><span t-esc="'{0:,.2f}'.format(doc.material_sale)"/></td>
                                </tr>
                                <tr>
                                    <td width="70%" class="text-left" style="padding: 0px 0px 0px 10px;">RV</td>
                                    <td width="30%" class="text-right" style="padding: 0px 10px; border-left: 1px solid lightgray;"><span t-esc="'{0:,.2f}'.format(doc.resalas_amount)"/></td>
                                </tr>
                                <tr style="font-weight: bold;">
                                    <td width="70%" class="text-right" style="padding: 0px 10px;">Total Revenue</td>
                                    <td width="30%" class="text-right" style="padding: 0px 10px; border-left: 1px solid white;"><span t-esc="'{0:,.2f}'.format(doc.total_sale)"/></td>
                                </tr>
                            </table>
                        </span>
                    </p>
                    <p class="col-xs-12">
