        <template id="template_boq_memo">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="bill_of_quantity_kopkarla.internal_layout">
                        <t t-if="doc.is_rental">
                            <t t-call="bill_of_quantity_kopkarla.template_boq_memo_rental"/>
                        </t>
                        <t t-else="">
                            <t t-call="bill_of_quantity_kopkarla.template_boq_memo_dokumen"/>
                        </t>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>