                                            <td style="text-align: right; vertical-align: middle; border:1px solid black;"><span t-esc="'{0:,.2f}'.format(baris.sale_subtotal)"/></td>
                                        </tr>
                                    </t>
                                    <tr style="font-size:12px; font-weight:bold;">
                                        <td style="text-align: right; vertical-align: middle; border:1px solid black;" colspan="6">Sub Total</td>
                                        <td style="text-align: right; vertical-align: middle; border:1px solid black;"><span t-esc="'{0:,.2f}'.format(price_subtotal)"/></td>
                                        <td style="text-align: right; vertical-align: middle; border:1px solid black;"><span t-esc="'{0:,.2f}'.format(service_subtotal)"/></td>
