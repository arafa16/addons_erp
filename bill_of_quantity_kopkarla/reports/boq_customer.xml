                        </table>
                    </div>
                </div>
            </t>
		</template>

        <template id="template_boq_customer">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-if="doc.is_rental">
                        <t t-call="bill_of_quantity_kopkarla.template_boq_customer_rental"/>
                    </t>
                    <t t-else="">
                        <t t-call="bill_of_quantity_kopkarla.template_boq_customer_dokumen"/>
                    </t>
                </t>
            </t>
        </template>
