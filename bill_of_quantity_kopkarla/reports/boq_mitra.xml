                        <div class="co-md-12">
                            <table class="table table-condensed">
                                <thead>
                                    <tr>
                                        <th rowspan="2" style="text-align: center; vertical-align: middle; border:1px solid black;" width="4%">No</th>
                                        <th rowspan="2" style="text-align: center; vertical-align: middle; border:1px solid black;" width="32%">Description</th>
                                        <th rowspan="2" style="text-align: center; vertical-align: middle; border:1px solid black;" width="8%">Unit</th>
                                        <th rowspan="2" style="text-align: center; vertical-align: middle; border:1px solid black;" width="8%">Vol</th>
                                        <th colspan="2" style="text-align: center; vertical-align: middle; border:1px solid black;" width="24%">Unit Price (Rp.) Mitra</th>
                                        <th colspan="2" style="text-align: center; vertical-align: middle; border:1px solid black;" width="24%">Total Price (Rp.) Mitra</th>
                                    </tr>
                                    <tr>
                                        <th style="text-align: center; vertical-align: middle; border:1px solid black;" width="12%">Material</th>
                                        <th style="text-align: center; vertical-align: middle; border:1px solid black;" width="12%">Services</th>
                                        <th style="text-align: center; vertical-align: middle; border:1px solid black;" width="12%">Material</th>
                                        <th style="text-align: center; vertical-align: middle; border:1px solid black;" width="12%">Services</th>
                                    </tr>
                                </thead>
                                <tbody class="sale_tbody">
                                    <t t-set="no" t-value="0"/>
                                    <t t-set="price_subtotal" t-value="0"/>
                                    <t t-set="service_subtotal" t-value="0"/>
                                    <t t-if="len(doc.line_mitra_ids)">
                                        <t t-foreach="doc.line_mitra_ids" t-as="baris">
                                            <tr style="font-size:12px;">
                                                <t t-set="no" t-value="no + 1"/>
                                                <t t-set="price_subtotal" t-value="price_subtotal + baris.price_subtotal"/>
                                                <t t-set="service_subtotal" t-value="service_subtotal + baris.service_subtotal"/>
                                                <td style="text-align: right; vertical-align: middle; border:1px solid black;"><span t-esc="no"/></td>
                                                <td style="text-align: left; vertical-align: middle; border:1px solid black;"><span t-field="baris.name"/></td>
                                                <td style="text-align: center; vertical-align: middle; border:1px solid black;"><span t-field="baris.uom_id.name"/></td>
                                                <td style="text-align: right; vertical-align: middle; border:1px solid black;"><span t-esc="'{0:,.2f}'.format(baris.qty)"/></td>
                                                <td style="text-align: right; vertical-align: middle; border:1px solid black;"><span t-esc="'{0:,.2f}'.format(baris.price_unit)"/></td>
                                                <td style="text-align: right; vertical-align: middle; border:1px solid black;"><span t-esc="'{0:,.2f}'.format(baris.price_service)"/></td>
                                                <td style="text-align: right; vertical-align: middle; border:1px solid black;"><span t-esc="'{0:,.2f}'.format(baris.price_subtotal)"/></td>
                                                <td style="text-align: right; vertical-align: middle; border:1px solid black;"><span t-esc="'{0:,.2f}'.format(baris.service_subtotal)"/></td>
                                            </tr>
                                        </t>
                                    </t>
