                                            <td style="text-align: left; vertical-align: middle; border:1px solid black;"><span t-field="baris.product_id.name"/></td>
                                            <td style="text-align: left; vertical-align: middle; border:1px solid black;"><span t-field="baris.name"/></td>
                                            <!--<td style="text-align: center; vertical-align: middle; border:1px solid black;"><span t-field="baris.uom_id.name"/></td>-->
                                            <td style="text-align: right; vertical-align: middle; border:1px solid black;"><span t-esc="'{0:,.0f}'.format(baris.qty)"/></td>
                                            <td style="text-align: right; vertical-align: middle; border:1px solid black;"><span t-esc="'{0:,.2f}'.format(baris.price_unit)"/></td>
                                            <!--<td style="text-align: right; vertical-align: middle; border:1px solid black;"><span t-esc="'{0:,.2f}'.format(baris.price_service)"/></td>-->
                                            <td style="text-align: right; vertical-align: middle; border:1px solid black;"><span t-esc="'{0:,.2f}'.format(baris.price_subtotal)"/></td>
                                            <!--<td style="text-align: right; vertical-align: middle; border:1px solid black;"><span t-esc="'{0:,.2f}'.format(baris.service_subtotal)"/></td>-->
                                            <td style="text-align: left; vertical-align: middle; border:1px solid black;"><span t-field="baris.franco"/></td>
                                            <td style="text-align: left; vertical-align: middle; border:1px solid black;"><span t-field="baris.delivery"/></td>
                                            <td style="text-align: left; vertical-align: middle; border:1px solid black;"><span t-field="baris.garansi"/></td>
                                        </tr>
                                    </t>
                                    <!--<tr style="font-size:12px; font-weight:bold;">
                                        <td style="text-align: right; vertical-align: middle; border:1px solid black;" colspan="5">Sub Total</td>
                                        <td style="text-align: right; vertical-align: middle; border:1px solid black;"><span t-esc="'{0:,.2f}'.format(price_subtotal)"/></td>
                                        <td style="text-align: right; vertical-align: middle; border:1px solid black;"><span t-esc="'{0:,.2f}'.format(service_subtotal)"/></td>
                                    </tr>-->
                                    <tr style="font-size:12px; font-weight:bold;">
                                        <td style="text-align: right; vertical-align: middle; border:1px solid black;" colspan="5">TOTAL</td>
                                        <td style="text-align: center; vertical-align: middle; border:1px solid black;"><span t-esc="'{0:,.2f}'.format(price_subtotal)"/></td>
                                        <td style="text-align: right; vertical-align: middle; border:1px solid black;" colspan="3"/>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </t>
		</template>

        <template id="template_boq_mitra">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-if="doc.is_rental">
                        <t t-call="bill_of_quantity_kopkarla.template_boq_mitra_rental"/>
                    </t>
                    <t t-else="">
                        <t t-call="bill_of_quantity_kopkarla.template_boq_mitra_dokumen"/>
                    </t>
                </t>
            </t>
        </template>
