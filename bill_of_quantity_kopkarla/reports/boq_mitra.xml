                                        <th style="text-align: center; vertical-align: middle; border:1px solid black;" width="9%">Garansi</th>
                                    </tr>
                                </thead>
                                <tbody class="sale_tbody">
                                    <t t-set="no" t-value="0"/>
                                    <t t-set="price_subtotal" t-value="0"/>
                                    <t t-set="service_subtotal" t-value="0"/>
                                    <t t-foreach="doc.line_material_ids" t-as="baris">
                                        <tr style="font-size:12px;">
