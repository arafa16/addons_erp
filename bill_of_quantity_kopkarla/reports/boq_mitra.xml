<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <data>
        <record id="paperformat_boq" model="report.paperformat">
            <field name="name">A4 BoQ</field>
            <field name="default" eval="True"/>
            <field name="format">A4</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">35</field>
            <field name="margin_bottom">10</field>
            <field name="margin_left">10</field>
            <field name="margin_right">10</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">30</field>
            <field name="dpi">80</field>
        </record>

        <report
            id="action_report_boq_mitra"
            string="BoQ Mitra"
            model="bill.quantity"
            report_type="qweb-pdf"
            name="bill_of_quantity_kopkarla.template_boq_mitra"
            file="bill_of_quantity_kopkarla.template_boq_mitra"
            print_report_name="'BoQ Mitra %s' % (object.name)"
            paperformat="paperformat_boq"/>

