<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="group_rfi_officer" model="res.groups">
            <field name="name">RFI Officer</field>
            <field name="category_id" ref="base.module_category_sales_management"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_rfi_manager" model="res.groups">
            <field name="name">RFI Manager</field>
            <field name="category_id" ref="base.module_category_sales_management"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
    </data>

    <data noupdate="1">
        <record model="ir.rule" id="personal_rfi_rule">
            <field name="name">Personal RFI</field>
            <field name="model_id" search="[('model','=','bill.quantity.line')]" model="ir.model"/>
            <field name="global" eval="False"/>
            <field name="domain_force">[('user_rfq_id','=',user.id)]</field>
            <field name="groups" eval="[(4, ref('bill_of_quantity_kopkarla.group_rfi_officer'))]" />
        </record>

        <record model="ir.rule" id="all_rfi_rule">
            <field name="name">All RFI</field>
            <field name="model_id" search="[('model','=','bill.quantity.line')]" model="ir.model"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('bill_of_quantity_kopkarla.group_rfi_manager'))]" />
        </record>
    </data>
</odoo>
