    <record model="ir.ui.view" id="view_bill_quantity_select_vendor_form">
        <field name="name">view.bill.quantity.select.vendor.form</field>
        <field name="model">bill.quantity.select.vendor</field>
        <field name="priority" eval="20"/>
        <field name="arch" type="xml">
            <form string="Select Vendor">
                <sheet>
                    <group>
                        <field name="bill_quantity_line_id" invisible="1"/>
                    </group>
                    <field name="product_rfi_ids">
                        <tree string="Select Vendor" create="false" editable="false" delete="false">
                            <!--<button name="action_select_vendor" string="Sel" type="object"/>-->
                            <field name="product_id" options="{'no_create': True, 'no_open': True}" invisible="1"/>
                            <!--<field name="type"/>-->
                            <!--<field name="uom_id" options="{'no_create': True, 'no_open': True}"/>-->
                            <field name="partner_id" options="{'no_create': True, 'no_open': True}" domain="[('supplier','=',True)]"/>
                            <field name="price_unit"/>
                            <!--<field name="create_date"/>-->
                            <field name="expired_date"/>
                            <field name="delivery"/>
                            <field name="franco"/>
                            <field name="garansi"/>
                            <field name="payment_term_id"/>
                            <field name="name"/>
                        </tree>
                    </field>
                    <group>
                        <field name="partner_id" options="{'no_create': True}"/>
                        <!--<field name="price_unit" readonly="1" force_save="1"/>
                        <field name="rfi_expired_date" readonly="1"/>-->
                    </group>
                </sheet>
                <footer>
                    <button string="Update" name="execute" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-default" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

