<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- List View -->
        <record model="ir.ui.view" id="em_request_tree">
            <field name="name">em.request.tree</field>
            <field name="model">em.request</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="tanggal"/>
                    <field name="picking_id"/>
                </tree>
            </field>
        </record>
        <record model="ir.ui.view" id="em_request_form">
            <field name="name">em.request.form</field>
            <field name="model">em.request</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <field name="stat" widget="statusbar" readonly="1"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name" required="1" attrs="{'readonly': [('stat', '!=', 'draft')]}"/>
                                <field name="tanggal" attrs="{'readonly': [('stat', '!=', 'draft')]}"/>
                            </group>
                            <group>
                                <field name="picking_id"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Material">
                                <field name="material_ids" attrs="{'readonly': [('stat', '!=', 'draft')]}">
                                    <tree editable="bottom" decoration-danger="moveopr == 'Dihapus'">
                                        <field name="barang_id"/>
                                        <field name="gudang_pengambilan" domain="[('usage','=','internal')]"/>
                                        <field name="tersedia" readonly="1"/>
                                        <field name="permintaan"/>
                                        <field name="direserve" readonly="1"/>
                                        <field name="dikirim" readonly="1"/>
                                        <field name="statx" readonly="1"/>
                                        <field name="moveopr" readonly="1" string="Operation Code"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <footer>
                        <button name="write"
                            string="Simpan"
                            type="object"
                            icon="fa-save" class="btn-primary"
                            attrs="{'invisible':[('stat', '!=', 'draft')]}"
                        />
                        <button name="set_proses"
                            string="Approve" icon="fa-check"
                            type="object" class="buttonsimpan"
                            attrs="{'invisible':['|',('stat', '!=', 'draft')]}"
                            groups="enhanced_sales_convert_project.group_projectmr_assign_user"
                        />
                    </footer>
                </form>
            </field>
        </record>
        <record model="ir.actions.act_window" id="em_request_action">
            <field name="name">Material Request</field>
            <field name="res_model">em.request</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree,form</field>
        </record>
        <!-- <menuitem 
            action="em_request_action"
            id="enhanced_material_request_menu" 
            name="Material Request" 
            parent="project.menu_project_config" sequence="10"/> -->
    </data>
</odoo>