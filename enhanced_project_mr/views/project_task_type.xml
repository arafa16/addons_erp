<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="epm_project_task_type_form">
            <field name="name">epm.project.task.type.form</field>
            <field name="model">project.task.type</field>
            <field name="inherit_id" ref="project.task_type_edit"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='project_ids']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='mail_template_id']" position="after">
                    <field name="material_req"/>
                    <field name="material_ret"/>
                    <field name="ready_invoice"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>