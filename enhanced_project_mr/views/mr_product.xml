<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- List View -->
        <record model="ir.ui.view" id="em_request_product_tree">
            <field name="name">em.request.product.tree</field>
            <field name="model">em.request.product</field>
            <field name="arch" type="xml">
                <tree editable="bottom">
                    <field name="barang_id"/>
                    <field name="gudang_pengambilan" domain="[('usage','=','internal')]"/>
                    <field name="tersedia" readonly="1"/>
                    <field name="permintaan"/>
                    <field name="dikirim" readonly="1"/>
                </tree>
            </field>
        </record>

        <record model="ir.actions.act_window" id="enhanced_material_request_product_action">
            <field name="name">Material Request Product</field>
            <field name="res_model">em.request.product</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree,form</field>
        </record>
        <!-- <menuitem 
            action="enhanced_material_request_product_action"
            id="enhanced_material_request_product_menu" 
            name="MR Product" 
            parent="project.menu_project_config" sequence="10"/> -->
    </data>
</odoo>