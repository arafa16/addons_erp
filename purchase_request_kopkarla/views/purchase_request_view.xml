<odoo>
    <data>
        <record model="ir.ui.view" id="view_sprogroup_purchase_request_form_reqtype">
            <field name="name">sprogroup.purchase.request.form.reqtype</field>
            <field name="model">sprogroup.purchase.request</field>
            <field name="inherit_id" ref="sprogroup_purchase_request.view_sprogroup_purchase_request_form"/>
            <field name="arch" type="xml">
<!--
                <xpath expr="//sheet/field[@name='is_editable']" position="before">
                    <div class="oe_button_box" name="button_box">
                        <button name="show_available_budget" type="object" class="oe_stat_button" icon="fa-book">
                            <field name="active_budget_count" widget="statinfo" string="Active Budget"/>
                        </button>
                    </div>
                </xpath>
-->
                <field name="requested_by" position="after">
                    <field name="allow_on_behalf_of" invisible="1"/>
                    <field name="on_behalf_of" options="{'no_open': True, 'no_create': True}" attrs="{'invisible': [('allow_on_behalf_of', '=', False)]}"/>
                </field>
                <field name="department_id" position="after">
                    <field name="request_type" attrs="{'invisible': [('salesorder_id', '!=', False)]}"/>
                </field>
                <xpath expr="//sheet/group/group/field[@name='salesorder_id']" position="attributes">
                    <attribute name="domain">[('state', 'in', ('sale','done'))]</attribute>
                </xpath>
                <field name="product_id" position="after">
                    <field name="salesorder_id" invisible="1"/>
                    <field name="account_id" force_save="1" readonly="1"/> <!--attrs="{'readonly':[('salesorder_id','!=',False)]}"/>-->
                </field>
            </field>
        </record>

        <record model="ir.ui.view" id="enhanced_purchase_request_loa_inherit_form_loa">
            <field name="model">sprogroup.purchase.request</field>
            <field name="inherit_id" ref="enhanced_purchase_request_loa.enhanced_purchase_request_loa_inherit_form"/>
            <field name="groups_id" eval="[(6,0, (ref('group_purchase_request_admin'),))]"/>
            <field name="arch" type="xml">
                <page name="pr_loa" position="replace">
                    <page name="pr_loa" string="Level of Approval">
                        <group>
                            <group>
                                <field name="penandatangan1" domain="[('otoritas_purchase.urutan', '=', 1)]" readonly="0" attrs="{'required':[('required1', '=', True)],'invisible':[('required1', '=', False)]}"/>
                                <field name="penandatangan2" domain="[('otoritas_purchase.urutan', '=', 2)]" readonly="0" attrs="{'required':[('required2', '=', True)],'invisible':[('required2', '=', False)]}"/>
                                <field name="penandatangan3" domain="[('otoritas_purchase.urutan', '=', 3)]" readonly="0" attrs="{'required':[('required3', '=', True)],'invisible':[('required3', '=', False)]}"/>
                                <field name="penandatangan4" domain="[('otoritas_purchase.urutan', '=', 4)]" readonly="0" attrs="{'required':[('required4', '=', True)],'invisible':[('required4', '=', False)]}"/>
                                <field name="penandatangan5" domain="[('otoritas_purchase.urutan', '=', 5)]" readonly="0" attrs="{'required':[('required5', '=', True)],'invisible':[('required5', '=', False)]}"/>
                            </group>
                            <group>
                                <field name="assman" domain="[('checkerPR','=',True)]" required="1" readonly="0"/>
                                <field name="issasman" invisible="1"/>
                                <field name="required1" invisible="1"/>
                                <field name="required2" invisible="1"/>
                                <field name="required3" invisible="1"/>
                                <field name="required4" invisible="1"/>
                                <field name="required5" invisible="1"/>
                            </group>
                        </group>
                    </page>
                </page>
            </field>
        </record>

        <record model="ir.ui.view" id="view_purchase_request_employee_mapping_tree">
            <field name="name">purchase.request.employee.mapping.tree</field>
            <field name="model">purchase.request.employee.mapping</field>
            <field name="arch" type="xml">
                <tree string="Purchase Request Employee Mapping" editable="bottom">
                    <field name="requested_by"/>
                    <field name="on_behalf_of"/>
                </tree>
            </field>
        </record>

        <record model="ir.actions.act_window" id="purchase_request_employee_mapping">
            <field name="name">Purchase Request On Behalf Of</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">purchase.request.employee.mapping</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree</field>
        </record>

        <menuitem
            id="menu_purchase_request_employee_mapping"
            sequence="10"
            parent="menu_purchase_request_configuration_act"
            action="purchase_request_employee_mapping"
            groups="sprogroup_purchase_request.group_sprogroup_purchase_request_user"
            />
    </data>
</odoo>
