<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="enhanced_wizard_purchasereport_form" model="ir.ui.view">
            <field name="name">enhanced.wizard.purchasereport.form</field>
            <field name="model">enhanced.wizard.purchasereport</field>
            <field name="arch" type="xml">
                <form>
                    <div style="white-space: pre-line;">
                        <h5>Report By date</h5>
                    </div>
                    <group>
                        <group>
                            <field name="tanggal_awal" required="1"/>
                            <field name="tanggal_ahir" required="1"/>
                        </group>
                        <group>
                        </group>
                    </group>
                    <footer>
                        
                        <button name="process_wizard"
                            string="XLS"
                            type="object"
                            class="oe_highlight"
                            />
                        <button string="Cancel" class="oe_link" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
        <record id="enhanced_wizard_purchasereport_action" model="ir.actions.act_window">
            <field name="name">Report Procurement</field>
            <field name="res_model">enhanced.wizard.purchasereport</field>
            <field name="view_mode">form</field>
            <field name="view_type">form</field>
            <field name="view_id" ref="enhanced_wizard_purchasereport_form"/>
            <field name="target">new</field>
        </record>
        <menuitem id="enhanced_wizard_purchasereport_menu" name="Report All Procurement" parent="purchase.menu_procurement_management" sequence="250" action="enhanced_wizard_purchasereport_action"/>
    </data>
</odoo>