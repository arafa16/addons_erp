<odoo>
    <data>
        <record id="account_account_form_parent" model="ir.ui.view">
            <field name="name">account.account.form.parent</field>
            <field name="model">account.account</field>
            <field name="inherit_id" ref="account.view_account_form"/>
            <field name="arch" type="xml">
            <data>
                <field name="name" position="after">
                    <field name="internal_type" readonly="0"/>
                </field>
                <field name="deprecated" position="after">
                    <field name="parent_id" domain="[('id', 'not in', [active_id])]"/>
                    <field name="child_ids">
                       <tree>
                        <field name="code"/>
                        <field name="name"/>
                       </tree>
                    </field>
                </field>
            </data>
            </field>
        </record>

        <record id="account_tree_hierarchy_parent" model="ir.ui.view">
            <field name="name">account.account.tree.hierarchy.parent</field>
            <field name="model">account.account</field>
            <field name="inherit_id" ref="account.view_account_list"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='user_type_id']" position="before">
                    <field name="parent_id"/>
                    <field name="internal_type"/>
                </xpath>
            </field>
        </record>

