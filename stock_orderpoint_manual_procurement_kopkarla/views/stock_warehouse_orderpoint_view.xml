<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_warehouse_orderpoint_purchase_tree_tbd" model="ir.ui.view">
        <field name="model">stock.warehouse.orderpoint</field>
        <field name="inherit_id" ref="stock_orderpoint_manual_procurement.view_warehouse_orderpoint_tree"/>
        <field name="arch" type="xml">
            <field name="immediately_usable_qty" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
        </field>
    </record>

    <record id="view_warehouse_orderpoint_purchase_tree_kopkarla" model="ir.ui.view">
        <field name="model">stock.warehouse.orderpoint</field>
        <field name="inherit_id" ref="stock.view_warehouse_orderpoint_tree"/>
        <field name="arch" type="xml">
            <field name="product_max_qty" position="after">
                <field name="qty_onhand"/> <!--invisible="context.get('not_show_critical_onhand', True)"/>-->
                <field name="qty_to_request" options="{'color_field': 'blue'}"/>
                <field name="qty_request"/> <!--invisible="context.get('not_show_critical_onhand', True)"/>-->
                <field name="qty_bid"/>
                <field name="qty_ordered"/> <!--invisible="context.get('not_show_critical_onhand', True)"/>-->
                <field name="product_minus" invisible="1"/>
            </field>
        </field>
    </record>

    <record id="view_warehouse_orderpoint_purchase_form" model="ir.ui.view">
        <field name="name">stock.warehouse.orderpoint.purchase.form</field>
        <field name="model">stock.warehouse.orderpoint</field>
        <field name="inherit_id" ref="stock.view_warehouse_orderpoint_form"/>
        <field name="arch" type="xml">
            <field name="qty_multiple" position="after">
                <field name="qty_onhand"/>
                <field name="qty_to_request" options="{'color_field': 'blue'}"/>
                <field name="qty_request"/>
                <field name="qty_bid"/>
                <field name="qty_ordered"/>
                <field name="product_minus" invisible="1"/>
            </field>
            <sheet position="inside">
                <notebook>
                    <page string="Purchase Request">
                        <field name="request_ids">
                            <tree>
                                <field name="request_id"/>
                                <field name="product_id"/>
                                <field name="name"/>
                                <field name="product_qty"/>
                                <!--<field name="ordered_qty"/>-->
                                <!--<field name="qty_to_order"/>-->
                                <field name="date_required"/>
                                <field name="request_state"/>
                            </tree>
                            <form>
                                <group>
                                    <group>
                                        <field name="request_id"/>
                                        <field name="product_id"/>
                                        <field name="name"/>
                                        <field name="request_state"/>
                                    </group>
                                    <group>
                                        <field name="product_qty"/>
                                        <!--<field name="ordered_qty"/>-->
                                        <!--<field name="qty_to_order"/>-->
                                        <field name="date_required"/>
                                    </group>
                                </group>
                            </form>
                        </field>
                    </page>
                    <page string="Bidding">
                        <field name="bid_ids">
                            <tree>
                                <field name="requisition_id"/>
                                <field name="product_id"/>
                                <field name="product_qty"/>
                                <field name="product_uom_id"/>
                                <!--<field name="qty_to_order"/>-->
                                <field name="schedule_date"/>
                                <field name="state"/>
                            </tree>
                            <form>
                                <group>
                                    <group>
                                        <field name="requisition_id"/>
                                        <field name="schedule_date"/>
                                        <field name="state"/>
                                    </group>
                                    <group>
                                        <field name="product_id"/>
                                        <field name="product_qty"/>
                                        <field name="product_uom_id"/>
                                        <!--<field name="ordered_qty"/>-->
                                        <!--<field name="qty_to_order"/>-->
                                        <!--<field name="schedule_date"/>-->
                                    </group>
                                </group>
                            </form>
                        </field>
                    </page>
                    <page string="Purchase Order">
                        <field name="order_ids">
                            <tree>
                                <field name="order_id"/>
                                <field name="product_id"/>
                                <field name="name"/>
                                <field name="partner_id"/>
                                <field name="price_unit"/>
                                <field name="product_qty"/>
                                <field name="qty_received"/>
                                <field name="qty_invoiced"/>
                                <field name="product_uom"/>
                                <field name="price_subtotal"/>
                                <field name="date_planned"/>
                                <field name="state"/>
                            </tree>
                            <form>
                                <group>
                                    <group>
                                        <field name="order_id"/>
                                        <field name="product_id"/>
                                        <field name="name"/>
                                        <field name="partner_id"/>
                                        <field name="date_planned"/>
                                        <field name="state"/>
                                    </group>
                                    <group>
                                        <field name="price_unit"/>
                                        <field name="product_qty"/>
                                        <field name="qty_received"/>
                                        <field name="qty_invoiced"/>
                                        <field name="product_uom"/>
                                        <field name="price_subtotal"/>
                                    </group>
                                </group>
                            </form>
                        </field>
                    </page>
                </notebook>
            </sheet>
        </field>
    </record>

    <record model="ir.ui.view" id="warehouse_orderpoint_search_tbd">
        <field name="name">stock.warehouse.orderpoint.search.tbd</field>
        <field name="model">stock.warehouse.orderpoint</field>
        <field name="inherit_id" ref="stock.warehouse_orderpoint_search"/>
        <field name="arch" type="xml">
            <filter name="inactive" position="after">
                <!--<field name="product_minus"/>
                <field name="product_min_qty"/>-->
                <filter string="Critical Onhand" name="critical_onhand" domain="[('product_minus','=',True)]"/>
            </filter>
        </field>
    </record>

</odoo>
