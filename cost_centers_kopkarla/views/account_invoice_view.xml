<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="invoice_form_cost_center_inherit" model="ir.ui.view">
            <field name="name">account.invoice.form</field>
            <field name="model">account.invoice</field>
            <field name="inherit_id" ref="sale.account_invoice_form"/>
            <field name="arch" type="xml">
                <!--<xpath expr="//field[@name='team_id']"
                            position="after">
                    <field name="cost_center_id" string="Cost Center"
                    options="{'no_quick_create':True,'no_create_edit':True}"/>
                </xpath>-->

                <xpath expr="//form/sheet/notebook/page/field[@name='invoice_line_ids']/tree/field[@name='account_analytic_id']" position="before">
                    <field name="cost_center_id" string="Cost Center" required="1"
                    options="{'no_quick_create':True,'no_create_edit':True, 'no_open':True}"/>
                </xpath>

            </field>
        </record>
        <record id="invoice_supplier_form_cost_center_inherit" model="ir.ui.view">
            <field name="name">account.invoice.supplier.form</field>
            <field name="model">account.invoice</field>
            <field name="inherit_id" ref="account.invoice_supplier_form"/>
            <field name="arch" type="xml">
                <!--<xpath expr="//field[@name='currency_id']"
                            position="after">
                    <field name="cost_center_id" string="Cost Center"
                    options="{'no_quick_create':True,'no_create_edit':True}"/>
                </xpath>-->
                <xpath expr="//form/sheet/notebook/page/field[@name='invoice_line_ids']/tree/field[@name='account_analytic_id']" position="before">
                    <field name="cost_center_id" string="Cost Center" required="1"
                    options="{'no_quick_create':True,'no_create_edit':True, 'no_open':True}"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>