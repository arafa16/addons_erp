<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_so_costs_margin_tree" model="ir.ui.view">
            <field name="name">Sales Margin</field>
            <field name="model">sale.order</field>
            <field name="priority">100</field>
            <field name="arch" type="xml">
                <tree string="Sales PR PO" decoration-bf="message_needaction==True" decoration-muted="state=='cancel'">
                    <field name="message_needaction" invisible="1"/>
                    <field name="name" string="Sales Order"/>
                    <field name="date_order"/>
                    <field name="confirmation_date"/>
                    <field name="nomor_spk"/>
                    <field name="amount_untaxed" string="SO Amount"/>
                    <field name="purchase_amount" string="Purchase Amount"/>
                    <field name="advance_amount" string="Advance Amount"/>
                    <field name="expense_amount" string="Expense Amount"/>
                    <field name="margin_so_costs" string="Margin"/>
                    <field name="state" invisible="1"/>
                </tree>
            </field>
        </record>

        <record id="view_sales_order_filter_margin" model="ir.ui.view">
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_sales_order_filter"/>
            <field name="arch" type="xml">
                <filter name="message_needaction" position="before">
                    <filter name="this_month"
                            string="This Month"
                            domain="['&amp;', ('date_order', '&gt;=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d')), ('date_order', '&lt;=', (context_today() + relativedelta(months=1, day=1, days=-1)).strftime('%Y-%m-%d'))]"/>
                    <filter string="Last Month"
                            name="last_month"
                            domain="['&amp;', ('date_order', '&gt;=', (context_today() - relativedelta(months=1)).strftime('%%Y-%%m-01')), ('date_order', '&lt;', context_today().strftime('%%Y-%%m-01'))]"/>
                    <filter string="This Year"
                            name="year"
                            domain="['|', ('date_order', '=', False), '&amp;',('date_order','&lt;=', time.strftime('%%Y-12-31')),('date_order','&gt;=',time.strftime('%%Y-01-01'))]"/>
                    <filter name="last_year"
                            string="Last Year"
                            domain="['&amp;', ('date_order', '&gt;=', (context_today()-relativedelta(years=1)).strftime('%Y-01-01')), ('date_order', '&lt;', context_today().strftime('%Y-01-01'))]"/>
                    <separator/>
                </filter>
            </field>
        </record>

        <record id="action_so_costs_margin" model="ir.actions.act_window">
            <field name="name">Sales Margin</field>
            <field name="res_model">sale.order</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="sale_project_kopkarla.view_so_costs_margin_tree"/>
            <!--<field name="context">{'search_default_general_order': 1, 'search_default_rental_order': 1, 'search_default_trading_datacom': 1}</field>-->
        </record>

        <menuitem id="menu_so_costs_margin"
            name="Sales Margin"
            action="action_so_costs_margin"
            parent="sale.menu_sale_report"
            sequence="1"/>
    </data>
</odoo>
