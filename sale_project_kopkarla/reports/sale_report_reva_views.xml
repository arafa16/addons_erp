<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sales_reva_pivot" model="ir.ui.view">
         <field name="name">sale.reva.report.pivot</field>
         <field name="model">sale.reva.report</field>
         <field name="arch" type="xml">
             <pivot string="Sales Analysis" disable_linking="True">
                 <field name="state" type="row"/>
                 <field name="reva_group_id" type="row"/>
                 <field name="reva_status" type="row"/>
                 <field name="analytic_account_id" type="row"/>
                 <!--<field name="confirmation_date" interval="month" type="row"/>-->
                 <field name="price_subtotal" type="measure"/>
                 <field name="dpp_to_invoice" type="measure"/>
                 <field name="dpp_invoiced" type="measure"/>
             </pivot>
         </field>
    </record>

    <record id="view_sales_reva_tree" model="ir.ui.view">
         <field name="name">sale.reva.report.tree</field>
         <field name="model">sale.reva.report</field>
         <field name="arch" type="xml">
             <tree string="Sales Analysis">
                 <field name="user_id"/>
                 <field name="requested_date"/>
                 <field name="date"/>
                 <field name="name"/>
                 <field name="state"/>
                 <field name="reva_status"/>
                 <field name="reva_group_id"/>
                 <field name="payment_term_id"/>
                 <field name="pek_type"/>
                 <field name="proj_type"/>
                 <field name="tgl_spk"/>
                 <field name="spk_sementara"/>
                 <field name="nojar"/>
                 <field name="delivery_date"/>
                 <field name="bast_no"/>
                 <field name="bast_date"/>
                 <field name="partner_shipping_id"/>
                 <field name="client_order_ref"/>
                 <field name="analytic_account_id"/>
                 <field name="price_subtotal"/>
                 <field name="dpp_to_invoice"/>
                 <field name="dpp_invoiced"/>
                 <field name="est_invoice_date"/>
                 <field name="partner_id"/>
                 <field name="cost_center_id"/>
                 <field name="price_total"/>
                 <field name="amt_to_invoice"/>
                 <field name="nomor_spk"/>
                 <field name="reva_notes"/>
                 <field name="ord_type"/>
                 <field name="daily_tgl_mulai"/>
                 <field name="daily_tgl_selesai"/>
             </tree>
         </field>
    </record>

    <record id="view_sale_reva_graph" model="ir.ui.view">
         <field name="name">sale.reva.report.graph</field>
         <field name="model">sale.reva.report</field>
         <field name="arch" type="xml">
             <graph string="Sales Analysis">
                 <field name="reva_group_id" type="row"/>
                 <field name="amt_to_invoice" type="measure"/>
             </graph>
         </field>
    </record>

    <!-- Custom reports (aka filters) -->
    <record id="filter_sale_reva_report_sales_funnel" model="ir.filters">
        <field name="name">Sales Funnel</field>
        <field name="model_id">sale.reva.report</field>
        <field name="domain">['&amp;', ('date','&lt;=', time.strftime('%%Y-12-31')), '&amp;', ('date','&gt;=',time.strftime('%%Y-01-01')), ('state','not in',('cancel',))]</field>
        <field name="user_id" eval="False"/>
        <field name="context">{'group_by': ['state'], 'measures': ['amount_untaxed']}</field>
    </record>
    <record id="filter_sale_reva_report_salespersons" model="ir.filters">
        <field name="name">By Salespersons</field>
        <field name="model_id">sale.reva.report</field>
        <field name="user_id" eval="False"/>
        <field name="context">{'group_by': ['date:month', 'user_id']}</field>
    </record>
    <record id="filter_sale_reva_report_salesteam" model="ir.filters">
        <field name="name">By Salesteam</field>
        <field name="model_id">sale.reva.report</field>
        <field name="user_id" eval="False"/>
        <field name="context">{'group_by': ['date:month', 'team_id']}</field>
    </record>

    <record id="view_sale_reva_search" model="ir.ui.view">
        <field name="name">sale.reva.report.search</field>
        <field name="model">sale.reva.report</field>
        <field name="arch" type="xml">
            <search string="Sales Analysis">
                <field name="date"/>
                <filter string="This Year" name="year" domain="[('date','&lt;=', time.strftime('%%Y-12-31')),('date','&gt;=',time.strftime('%%Y-01-01'))]"/>
                <filter string="Last Year and Before" name="last_year" domain="[('date','&lt;',time.strftime('%%Y-01-01'))]"/>
                <!--<filter name="Quotations" string="Quotations" domain="[('state','in', ('draft', 'sent'))]"/>
                <filter name="Sales" string="Sales" domain="[('state','not in',('draft', 'cancel', 'sent'))]"/>
                <filter name="Outstanding" string="Outstanding" domain="[('amt_to_invoice','!=', 0)]"/>-->
                <separator/>
                <filter string="Lock" name="state_lock" domain="[('state','=','done')]"/>
                <filter string="Sales Order" name="state_sale" domain="[('state','=','sale')]"/>
                <filter string="LoA Confirmed" name="state_loa" domain="[('state','=','loaconfirmed')]"/>
                <filter string="Request LoA" name="state_req_loa" domain="[('state','=','requestloa')]"/>
                <filter string="Assman Check" name="state_assman" domain="[('state','=','assmancheck')]"/>
                <filter string="SPV Check" name="state_spv" domain="[('state','=','spvcheck')]"/>
                <filter string="Sent" name="state_sent" domain="[('state','=','sent')]"/>
                <filter string="Draft" name="state_draft" domain="[('state','=','draft')]"/>
                <filter string="Cancelled" name="state_cancel" domain="[('state','=','cancel')]"/>
                <separator/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <group expand="0" string="Extended Filters">
                    <field name="company_id" groups="base.group_multi_company"/>
                </group>
                <group expand="1" string="Group By">
                    <filter string="Salesperson" name="User" context="{'group_by':'user_id'}"/>
                    <!--<filter string="Sales Channel" context="{'group_by':'team_id'}"/>-->
                    <filter string="Partner's Country" name="country_id" context="{'group_by':'country_id'}"/>
                    <filter string="Customer" name="Customer" context="{'group_by':'partner_id'}"/>
                    <filter name="status" string="Status" context="{'group_by':'state'}"/>
                    <filter string="Company" groups="base.group_multi_company" context="{'group_by':'company_id'}"/>
                    <separator/>
                    <filter string="Analytic Account" context="{'group_by':'analytic_account_id'}" help="Ordered by reional of the sales order"/>
                    <filter string="Order Month" context="{'group_by':'date:month'}" help="Ordered date of the sales order"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_order_report_sale_reva" model="ir.actions.act_window">
        <field name="name">Sales Reva Analysis</field>
        <field name="res_model">sale.reva.report</field>
        <field name="view_type">form</field>
        <field name="view_mode">pivot,tree,graph</field>
        <field name="view_id"></field>  <!-- force empty -->
        <field name="search_view_id" ref="view_sale_reva_search"/>
        <!--<field name="context">{'search_default_Outstanding':1, 'group_by_no_leaf':1,'group_by':[]}</field>-->
        <field name="context">{'group_by_no_leaf':1,'group_by':[],'search_default_state_lock':1,'search_default_state_sale':1}</field>
        <field name="help">This report performs analysis on your quotations and sales orders. Analysis check your sales revenues and sort it by different group criteria (salesman, partner, product, etc.) Use this report to perform analysis on sales not having invoiced yet. If you want to analyse your turnover, you should use the Invoice Analysis report in the Accounting application.</field>
    </record>

    <menuitem id="menu_report_sale_reva"
        name="Sales Reva"
        action="action_order_report_sale_reva"
        parent="sale.menu_sale_report"
        sequence="1"/>
</odoo>
