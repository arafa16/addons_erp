<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="num_to_words_inherit_custom_report_purchaseorder_document" inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//p[@t-field='o.notes']" position="before">
            <p t-if='o.text_amount'>
                <strong>Total amount in words:</strong>
                <span t-field="o.text_amount"/>
            </p>
        </xpath>

    </template>
</odoo>
