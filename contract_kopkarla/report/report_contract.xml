<?xml version="1.0" ?>
<odoo>
    <template id="report_contract_document" inherit_id="contract.report_contract_document">
        <xpath expr="//div[@id='invoice_info']/div[2]" position="replace">
            <div class="col-xs-12">
                <div style="font-weight:bold; text-decoration:underline;">
                    Kondisi Penawaran:
                </div>
                <p t-field="o.note"/>
                <div style="padding-top:10px;">
                    <div style="float:left;">
                        <div style="padding-top:35px;">
                            Hormat kami,<br/>
                        </div>
                        <div style="padding-top:110px;">
                            <div style="font-weight:bold; text-decoration:underline;" t-field="o.pegawai_ttd"></div>
                            <div t-field="o.penandatangan.name"></div>
                        </div>
                    </div>
                    <div style="float:right;">
                        <div style="padding-top:35px;">
                            Menyetujui,<br/>
                            <span t-field="o.partner_id.name"/>
                        </div>
                        <div style="padding-top:90px;">
                            (______________)
                        </div>
                    </div>
                </div>
                <div style="clear:both;"/>
            </div>
        </xpath>
    </template>

</odoo>
