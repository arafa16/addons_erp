<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- List View -->
        <record model="ir.ui.view" id="enhanced_sales_area_tabel_tree">
            <field name="name">enhanced.sales.project.area.tree</field>
            <field name="model">enhanced.sales.area</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="description"/>
                    <field name="urutan"/>
                </tree>
            </field>
        </record>
        
        <!-- Form View -->
        <record model="ir.ui.view" id="enhanced_sales_area_tabel_form">
            <field name="name">enhanced.sales.project.area.form</field>
            <field name="model">enhanced.sales.area</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="fungsi_sementara"
                            string="fungsi sementara"
                            type="object"
                        />
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="description"/>
                            </group>
                            <group>
                                <field name="urutan"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="enhanced_sales_area_tabel_action">
            <field name="name">Sales Area</field>
            <field name="res_model">enhanced.sales.area</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
    <menuitem id="tabel_master_sales_area"
            name="Master Sales Area"
            parent="sale.menu_sale_config"
            action="enhanced_sales_area_tabel_action"
            sequence="6"/>
</odoo>