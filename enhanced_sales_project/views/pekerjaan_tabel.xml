<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- List View -->
        <record model="ir.ui.view" id="enhanced_sales_pekerjaan_tabel_tree">
            <field name="name">enhanced.sales.pekerjaan.tabel.tree</field>
            <field name="model">enhanced.sales.pekerjaan.tabel</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="bypassLoA"/>
                    <field name="urutan"/>
                </tree>
            </field>
        </record>
        
        <!-- Form View -->
        <record model="ir.ui.view" id="enhanced_sales_pekerjaan_tabel_form">
            <field name="name">enhanced.sales.pekerjaan.tabel.form</field>
            <field name="model">enhanced.sales.pekerjaan.tabel</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="bypassLoA"/>
                                <field name="urutan"/>
                            </group>
                            <group>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="enhanced_sales_pekerjaan_tabel_action">
            <field name="name">Master Jenis Pekerjaan tabel</field>
            <field name="res_model">enhanced.sales.pekerjaan.tabel</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
    <menuitem id="tabel_master_sales_pekerjaan"
            name="Data Master Jenis Pekerjaan"
            parent="sale.menu_sale_config"
            action="enhanced_sales_pekerjaan_tabel_action"
            sequence="4"/>
</odoo>
