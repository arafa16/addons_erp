        <record model="ir.ui.view" id="project_pr_inherit_main_form">
            <field name="name">project.pr.inherit.main.form</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="project.view_task_form2"/>
            <field name="arch" type="xml">
                <xpath expr="//form/header" position="inside">
                    <button name="action_request_cash_advance" string="Cash Advance" type="object"/>
                    <button name="action_expense_sheet" string="Expense" type="object"/>
                </xpath>
                <xpath expr="//form/sheet/notebook/page[@name='description_page']" position="before">
                    <page name="page_cash_advance" string="Cash Advance">
                        <field name="advance_ids" readonly="1"/>
                    </page>
                    <page name="page_expense_sheete" string="Expense">
                        <field name="sheet_ids" readonly="1"/>
                    </page>
                </xpath>
            </field>
        </record>
