<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="enhanced_inventoryadjustment" inherit_id="stock.report_inventory">
                <xpath expr="//span[@t-field='line.product_qty']" position="replace">
                    <t t-if="line.product_qty != 0">
                        <span t-field="line.product_qty"/>
                    </t>
                </xpath>
        </template>
    </data>
</odoo>