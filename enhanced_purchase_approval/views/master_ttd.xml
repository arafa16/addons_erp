<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- List View -->
        <record model="ir.ui.view" id="enhanced_master_ttd_purchase_tree">
            <field name="name">enhanced.master.ttd.purchase.tree</field>
            <field name="model">tabel.ttd.purhchase</field>
            <field name="arch" type="xml">
                <tree editable="bottom">
                    <field name="urutan"/>
                    <field name="name"/>
                    <field name="next_step"/>
                    <field name="batas_bawah"/>
                    <field name="batas_atas"/>
                </tree>
            </field>
        </record>

        <record model="ir.actions.act_window" id="enhanced_master_ttd_purchase_action">
            <field name="name">Master LOA Purchase</field>
            <field name="res_model">tabel.ttd.purhchase</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree,form</field>
        </record>
        <menuitem id="tabel_rujukan_ttd_purchase_menu"
            name="Master LOA Purchase"
            parent="purchase.menu_purchase_config"
            action="enhanced_master_ttd_purchase_action"
            sequence="3"/>
    </data>
</odoo>