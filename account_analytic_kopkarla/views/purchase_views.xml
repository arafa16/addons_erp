<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_inherit" model="ir.ui.view">
        <field name="name">purchase.order.inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
<!--            <field name="account_analytic_id" position="replace"/>-->
            <field name="date_approve" position="after">
                <field name="analytic_account_id" options="{'no_create':True, 'no_open':True}" required="True"/>
            </field>
            <!--<xpath expr="//form/sheet/notebook/page/field[@name='order_line']/tree/field[@name='product_id']" position="options">-->
            <xpath expr="//tree/field[@name='account_analytic_id']" position="replace">
                <field name="account_analytic_id" options="{'no_create':True, 'no_open':True}" invisible="1"/>
            </xpath>
            <field name="analytic_tag_ids" position="replace"/>
        </field>
    </record>
</odoo>
