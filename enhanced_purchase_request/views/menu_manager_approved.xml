<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="sprogroup_purchase_request_manager_approve_tree">
            <field name="name">sprogroup.purchase.request.manager.approve.tree</field>
            <field name="model">sprogroup.purchase.request</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="namex"/>
                    <field name="date_start"/>
                    <field name="requested_by"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <record model="ir.actions.act_window" id="sprogroup_purchase_request_manager_approve_action">
            <field name="name">Purchase Request Sent to Procure</field>
            <field name="res_model">sprogroup.purchase.request</field>
            <field name="view_type">form</field>
            <field name="domain">[('state', 'in', ['leader_approved','manager_approved'])]</field>
            <field name="view_id" ref="sprogroup_purchase_request_manager_approve_tree"/>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem 
            id="sprogroup_purchase_request_manager_approve_menu"
            name="Budget sent to Procure"
            parent="purchase.menu_procurement_management"
            sequence="6"
            action="sprogroup_purchase_request_manager_approve_action"
            groups="sprogroup_purchase_request.group_sprogroup_purchase_request_manager"
        />

    </data>
</odoo>