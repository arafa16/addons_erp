<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_commitment" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.commitment</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="25"/>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@data-key='purchase']" position="inside">
                <h2>Commitment</h2>
                <div class="row mt16 o_settings_container">
                    <div class="col-xs-12 col-md-6 o_setting_box" title="Make you able to choose if you want to enter budgets planned amount in a positive or negative form">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="planned_amount_sign"/>
                            <div class="text-muted">
                                Make you able to choose if you want to enter budgets planned amount in a positive or negative form
                            </div>
                            <div class="content-group">
                                <div class="mt16">
                                    <field name="planned_amount_sign" class="o_light_label" widget="radio"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <record id="res_config_settings_view_form_ledger_budget_control" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.ledger.budget.control</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="25"/>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='module_account_budget']/../.." position="after">
                <div class="col-xs-12 col-md-6 o_setting_box" id="budget_control_settings">
                    <div class="o_setting_left_pane">
                        <field name="allow_budget_ledger_control"/>
                    </div>
                    <div class="o_setting_right_pane" name="budget_control_right_pane">
                        <label for="allow_budget_ledger_control" string="Ledger Budget Control"/>
                        <div class="text-muted">
                            Allow budget control on accounts with budget applied in every ledger journal posting
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
