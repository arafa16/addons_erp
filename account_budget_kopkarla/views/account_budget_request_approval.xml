        <record model="ir.ui.view" id="account_budget_approval_form">
            <field name="name">account.budget.approval.form</field>
            <field name="model">budget.request</field>
            <field name="arch" type="xml">
                <form string="Budget Approval">
                    <!--<script>
                        $(document).ready(function(){
                        $(".modal-header").hide();
                        $(".modal-footer").hide();
                        });
                    </script>-->
                    <!--<header>
                        <field name="show_force_approval" invisible="1"/>
                        <button string="Un-Budget Approve" name="budget_request_approve_action" type="object"
                                class="widgetbuttonmerah oe_stat_button" context="{'force': 1}"
                                attrs="{'invisible': [('allow_unbudget', '=', False)]}"
                        />
                        <button string="Approve" name="budget_request_approve_action" type="object"
                                class="oe_highlight" context="{'force': 0}"
                                attrs="{'invisible': [('allow_unbudget', '=', True)]}"
                        />
                        <button special="cancel" string="Cancel" class="oe_link" />
                    </header>-->
                    <sheet string="Budget Approval">
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1>
                                <field name="name" placeholder="Budget Name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="state" invisible="1"/>
                                <field name="date"/>
                                <field name="description"/>
                                <field name="show_asset_budget" invisible="1"/>
                            </group>
                            <group>
                                <field name="origin"/>
                                <field name="request_id"/>
                                <field name="allow_unbudget" attrs="{'invisible': [('show_force_approval', '=', False)]}"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Budget Lines">
                                <!--<field name="line_ids" colspan="4" nolabel="1" editable="top" delete="false">-->
                                <field name="line_ids">
                                    <tree string="Budget Lines" editable="bottom" create="false" edit="false" delete="false">
                                        <field name="budget_account_id" string="Expense Account"/>
                                        <field name="income_account_id" string="Income Account" attrs="{'column_invisible': [('parent.sale_order_id', '=', False)]}"/>
                                        <field name="cost_center_id"/>
                                        <field name="analytic_account_id"/>
                                        <field name="asset_options" attrs="{'column_invisible': [('parent.show_asset_budget', '=', False)]}"/>
                                        <field name="requested_amount" string="Requested"/>
                                        <field name="available_budget" string="Budget" force_save="1"/>
                                        <field name="restrict_allow" string="Control" force_save="1"/>
                                        <field name="selected_budget_id" options="{'no_create': True}" force_save="1"/>
                                        <!--<button string="..." name="show_available_budget" type="object" class="oe_highlight"/>-->
                                    </tree>
                                    <!--<form string="Budget Lines">
                                        <group>
                                            <group>
                                                <field name="general_budget_id"/>
                                                <field name="planned_amount" widget="monetary"/>
                                                <field name="analytic_account_id" groups="analytic.group_analytic_accounting" required="1"/>
                                            </group>
                                            <group>
                                                <label for="date_from" string="Period"/>
                                                <div>
                                                    <field name="date_from" class="oe_inline"/> -
                                                    <field name="date_to" class="oe_inline"/>
                                                </div>
                                                <field name="paid_date" groups="base.group_no_one"/>
                                                <field name="company_id" options="{'no_create': True}" groups="base.group_multi_company"/>
                                            </group>
                                        </group>
                                    </form>-->
                                </field>
                            </page>
                            <page string="Sales Order" attrs="{'invisible': [('sale_order_id', '=', False)]}">
                                <group>
                                    <group>
                                        <field name="sale_order_id"/>
                                        <field name="sale_confirm_date"/>
                                        <field name="sale_delivery_doc"/>
                                        <field name="sale_amount_total"/>
                                    </group>
                                    <group>
                                        <field name="sale_area_kode"/>
                                        <field name="nojar"/>
                                        <field name="proj_type"/>
                                        <field name="ord_type"/>
                                        <field name="pek_type"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Proyeksi Margin" attrs="{'invisible': [('sale_order_id', '=', False)]}">
                                <field name="margin_ids">
                                    <tree string="Proyeksi Margin" editable="bottom" create="false" edit="false" delete="false">
                                        <field name="name"/>
                                        <field name="amount"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <footer attrs="{'invisible:': []}">
                        <field name="show_force_approval" invisible="1"/>
                        <button string="Un-Budget Approve" name="budget_request_approve_action" type="object"
                                class="widgetbuttonmerah oe_stat_button" context="{'force': 1}"
                                attrs="{'invisible': ['|',('allow_unbudget', '=', False),('state', '=', 'done')]}"
                        />
                        <button string="Approve" name="budget_request_approve_action" type="object"
                                class="oe_highlight" context="{'force': 0}"
                                attrs="{'invisible': ['|',('allow_unbudget', '=', True),('state', '=', 'done')]}"
                        />
                        <button special="cancel" string="Cancel" class="oe_link" attrs="{'invisible': [('state', '=', 'done')]}"/>
                        <button special="cancel" string="Close" class="oe_link" attrs="{'invisible': [('state', '!=', 'done')]}"/>
                    </footer>
                </form>
            </field>
        </record>

        <!--<template id="redirect_fail_page" name="Failure Code Page">
