<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_budget_release_request_tree" model="ir.ui.view">
            <field name="name">budget.release.tree.view</field>
            <field name="model">budget.request</field>
            <field name="arch" type="xml">
                <tree string="Budget Release Approval" create="false" edit="true" delete="true"
                      decoration-danger="state=='release'"
                      decoration-info="state=='done'"
                      decoration-muted="state=='draft'">
                    <field name="name"/>
                    <field name="request_id"/>
                    <field name="requested_amount"/>
                    <field name="released_amount"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <record id="view_budget_release_request_form" model="ir.ui.view">
            <field name="name">budget.release.form.view</field>
            <field name="model">budget.request</field>
            <field name="priority">51</field>
            <field name="arch" type="xml">
                <form string="Budget Release Approval">
                    <header>
                        <field name="show_force_approval" invisible="1"/>
                        <!--<button special="cancel" string="Cancel" class="oe_link" attrs="{'invisible': [('state', '=', 'done')]}"/>
                        <button special="cancel" string="Close"
                                class="oe_highlight"
                                attrs="{'invisible': [('state', '!=', 'done')]}"/>-->
                        <button string="Release Budget" name="budget_request_release_post_action" type="object"
                                class="oe_highlight"
                                attrs="{'invisible': [('state', '!=', 'release')]}"/>
                        <button string="Reject" name="budget_request_release_cancel_action" type="object"
                                attrs="{'invisible': [('state', '!=', 'release')]}"/>
                    </header>
                    <sheet string="Budget Approval">
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1>
                                <field name="name" placeholder="Budget Name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="state" invisible="1"/>
                                <field name="date"/>
                                <field name="description"/>
                                <field name="requested_amount"/>
                                <field name="released_amount" readonly="1"/>
                                <field name="show_asset_budget" invisible="1"/>
                            </group>
                            <group>
                                <field name="origin"/>
                                <field name="request_id"/>
                                <field name="allow_unbudget" attrs="{'invisible': [('show_force_approval', '=', False)]}"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Budget Lines">
                                <!--<field name="line_ids" colspan="4" nolabel="1" editable="top" delete="false">-->
                                <field name="line_ids">
                                    <tree string="Budget Lines" editable="bottom" domain="[('is_release', '=', True)]">
                                        <field name="budget_account_id" string="Expense Account"/>
                                        <field name="income_account_id" string="Income Account" attrs="{'column_invisible': [('parent.sale_order_id', '=', False)]}"/>
                                        <field name="cost_center_id"/>
                                        <field name="analytic_account_id"/>
                                        <field name="asset_options" attrs="{'column_invisible': [('parent.show_asset_budget', '=', False)]}"/>
                                        <field name="requested_amount" string="Requested"/>
                                        <field name="released_amount" string="Released" attrs="{'column_invisible': [('parent.state', '=', 'draft')]}"/>
                                        <field name="available_budget" string="Budget" force_save="1"/>
                                        <field name="restrict_allow" string="Control" force_save="1"/>
                                        <field name="selected_budget_id" options="{'no_create': True}" force_save="1"/>
                                        <!--<button string="..." name="show_available_budget" type="object" class="oe_highlight"/>-->
                                    </tree>
                                </field>
                            </page>
                            <page string="Sales Order" attrs="{'invisible': [('sale_order_id', '=', False)]}">
                                <group>
                                    <group>
                                        <field name="sale_order_id"/>
                                        <field name="sale_confirm_date"/>
                                        <field name="sale_delivery_doc"/>
                                        <field name="sale_amount_total"/>
                                    </group>
                                    <group>
                                        <field name="sale_area_kode"/>
                                        <field name="nojar"/>
                                        <field name="proj_type"/>
                                        <field name="ord_type"/>
                                        <field name="pek_type"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Proyeksi Margin" attrs="{'invisible': [('sale_order_id', '=', False)]}">
                                <field name="margin_ids">
                                    <tree string="Proyeksi Margin" editable="bottom" create="false" edit="false" delete="false">
                                        <field name="name"/>
                                        <field name="amount"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="act_budget_release_request">
            <field name="name">Budget Release Approval</field>
            <field name="res_model">budget.request</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" eval="False"/>
            <!--<field name="search_view_id" ref="purchase_budget_request_search"/>-->
            <field name="domain">[('state', '=', 'release')]</field>
            <!--<field name="context">{ 'search_default_cost_center':True,
                                    'search_default_analytic_account':True,
                                    'search_default_request':True,}</field>-->
        </record>

        <record id="action_budget_release_request_tree_view" model="ir.actions.act_window.view">
            <field eval="1" name="sequence"/>
            <field name="view_mode">tree</field>
            <field name="view_id" ref="view_budget_release_request_tree"/>
            <field name="act_window_id" ref="act_budget_release_request"/>
        </record>

        <record id="action_budget_release_request_form_view" model="ir.actions.act_window.view">
            <field eval="2" name="sequence"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_budget_release_request_form"/>
            <field name="act_window_id" ref="act_budget_release_request"/>
        </record>

        <menuitem id="menu_act_budget_release_request_list"
                  name="Budget Release Approval"
                  parent="menu_budget_documents"
                  action="act_budget_release_request" sequence="3"
                  groups="account.group_account_user"/>

