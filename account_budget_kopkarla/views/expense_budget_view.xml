<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_expenses_budget_tree" model="ir.ui.view">
            <field name="name">hr.expense.tree</field>
            <field name="model">hr.expense</field>
            <field eval="50" name="priority"/>
            <field name="arch" type="xml">
                <tree string="Expenses" decoration-bf="message_unread == True" class="o_expense_tree">
                    <!--<field name="cost_center_id"/>
                    <field name="analytic_account_id" groups="analytic.group_analytic_accounting"/>-->
                    <field name="currency_id" invisible="True"/>
                    <field name="attachment_number" invisible="True"/>
                    <field name="product_id"/>
                    <field name="name"/>
                    <field name="total_amount" sum="Total Amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    <field name="date"/>
                    <field name="sheet_id"/>
                    <field name="employee_id"/>
                    <field name="state"/>
                    <field name="message_unread" invisible="1"/>
                </tree>
            </field>
        </record>

        <record id="view_hr_expense_filter_budget" model="ir.ui.view">
            <field name="name">hr.expense.filter.budget</field>
            <field name="model">hr.expense</field>
            <field eval="50" name="priority"/>
            <field name="arch" type="xml">
                <search string="Expense">
                    <field name="account_id"/>
                    <field name="name" string="Expenses" filter_domain="['|',('employee_id','ilike',self),('name','ilike',self)]"/>
                    <field name="date"/>
                    <field name="employee_id"/>
                    <field name="product_id"/>
                    <!--<field name="analytic_account_id" groups="analytic.group_analytic_accounting"/>-->
                    <separator/>
                    <filter name="this_month"
                            string="This Month"
                            domain="['&amp;', ('accounting_date', '&gt;=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d')), ('accounting_date', '&lt;=', (context_today() + relativedelta(months=1, day=1, days=-1)).strftime('%Y-%m-%d'))]"/>
                    <filter string="Last Month"
                            name="last_month"
                            domain="['&amp;', ('accounting_date', '&gt;=', (context_today() - relativedelta(months=1)).strftime('%%Y-%%m-01')), ('accounting_date', '&lt;', context_today().strftime('%%Y-%%m-01'))]"/>
                    <filter string="This Year"
                            name="year"
                            domain="['|', ('accounting_date', '=', False), '&amp;',('accounting_date','&lt;=', time.strftime('%%Y-12-31')),('accounting_date','&gt;=',time.strftime('%%Y-01-01'))]"/>
                    <filter name="last_year"
                            string="Last Year"
                            domain="['&amp;', ('accounting_date', '&gt;=', (context_today()-relativedelta(years=1)).strftime('%Y-01-01')), ('accounting_date', '&lt;', context_today().strftime('%Y-01-01'))]"/>
                    <separator/>
                    <group expand="0" string="Group By">
                        <filter string="Report" domain="[]" context="{'group_by': 'sheet_id'}"/>
                        <filter string="Employee" domain="[]" context="{'group_by': 'employee_id'}"/>
                        <filter string="Company" domain="[]" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                        <filter string="Product" domain="[]" context="{'group_by': 'product_id'}"/>
                        <filter name="account" string="Account" icon="terp-personal"
                                domain="[]"
                                context="{'group_by':'account_id'}"/>
                        <filter name="cost_center" string="Cost Center" icon="terp-personal"
                                domain="[]"
                                context="{'group_by':'cost_center_id'}"/>
                        <filter name="analytic_account" string="Analytic Account" icon="terp-personal"
                                domain="[]"
                                context="{'group_by':'analytic_account_id'}"/>
                        <!--<filter string="Expenses Month" domain="[]" context="{'group_by': 'date'}" help="Expenses by Month"/>
                        <filter string="Status" domain="[]" context="{'group_by': 'state'}"/>-->
                    </group>
                    <!--<separator/>-->
                    <!--<filter domain="[('employee_id.active', '=', False)]" string="Former Employees" name="inactive" groups="hr_expense.group_hr_expense_user,hr_expense.group_hr_expense_manager"/>-->
                </search>
            </field>
        </record>

        <record model="ir.actions.act_window" id="act_expenses_budget_tree">
            <field name="name">Expense Details</field>
            <field name="res_model">hr.expense</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree</field>
            <field name="view_id" ref="view_expenses_budget_tree"/>
            <field name="search_view_id" ref="view_hr_expense_filter_budget"/>
            <field name="domain">[('state', 'in', ['post','done'])]</field>
            <field name="context">{ 'search_default_account': True,
                                    'search_default_cost_center': True,
                                    'search_default_analytic_account': True,
                                    'search_default_this_month': True,
                }</field>
        </record>

        <menuitem parent="account_budget_kopkarla.menu_budget_reports"
            id="menu_act_expenses_budget_tree"
            name="Expense Details"
            action="act_expenses_budget_tree" sequence="5"
            groups="account.group_account_user"/>
    </data>
</odoo>