<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="account_budget_post_commitment_limit_form_view" model="ir.ui.view">
            <field name="name">account.budget.post.commitment_limit.tree</field>
            <field name="model">account.budget.post.commitment_limit</field>
            <field name="arch" type="xml">
                <tree string="Budgetary Position Commitment Limit" editable="top">
                    <field name="budget_post_id" invisible="context.get('budget_pos_view')"/>
                    <field name="user_id" invisible="context.get('res_users_view')"/>
                    <field name="amount_limit"/>
                </tree>
            </field>
        </record>

        <record id="view_budget_post_tree_inherit" model="ir.ui.view">
            <field name="name">account.budget.post.tree.inherit</field>
            <field name="model">account.budget.post</field>
            <field name="inherit_id" ref="account_budget.view_budget_post_tree"/>
            <field name="arch" type="xml">
                <field name="name" position="replace">
                    <field name="group_id" invisible="1"/>
                    <field name="name"/>
                    <field name="sign"/>
                </field>
            </field>
        </record>

        <record model="ir.ui.view" id="view_budget_post_form">
            <field name="name">account.budget.post.form</field>
            <field name="model">account.budget.post</field>
            <field name="inherit_id" ref="account_budget.view_budget_post_form"/>
            <field name="arch" type="xml">
                <field name="name" position="after">
                    <field name="budget_type"/>
                    <field name="group_id"/>
                    <field name="sign"/>
                </field>
                <xpath expr="//notebook/page" position="replace"/>
                <notebook position="inside">
                    <page name="asset" string="Asset"
                          attrs="{'invisible':[('budget_type','==','ledger')], 'focus':[('budget_type','==','asset')]}">
                        <field name="budget_asset_ids"/>
                    </page>
                    <page string="Accounts">
                        <field name="account_ids">
                            <tree>
                                <field name="code"/>
                                <field name="name"/>
                            </tree>
                        </field>
                    </page>
                    <page name="limits" string="Commitment Limits">
                        <field name="commitment_limit_ids"
                               context="{'budget_pos_view': True, 'default_budget_post_id': active_id}"/>
                    </page>
                </notebook>
            </field>
        </record>

        <record id="view_budget_post_search" model="ir.ui.view">
            <field name="name">account.budget.post.search</field>
            <field name="model">account.budget.post</field>
            <field name="inherit_id" ref="account_budget.view_budget_post_search"/>
            <field name="arch" type="xml">
                <field name="company_id" position="after">
                    <group string="Group by .." expand="1">
                        <filter name="group_id" string="Budget Group" domain="[]" context="{'group_by':'group_id'}"/>
                    </group>
                </field>
            </field>
        </record>

        <record model="ir.ui.view" id="crossovered_budget_view_inherit">
            <field name="name">crossovered.budget.view.inherit</field>
            <field name="model">crossovered.budget</field>
            <field name="inherit_id" ref="account_budget.crossovered_budget_view_form"/>
            <field name="arch" type="xml">
                <field name="creating_user_id" position="replace">
                    <field name="cost_center_id" attrs="{'readonly':[('state','!=','draft')]}" options="{'no_create': True, 'no_open':True}"/>
                    <field name="analytic_account_id" attrs="{'readonly':[('state','!=','draft')]}" options="{'no_create': True, 'no_open':True}"/>
                </field>
                <field name="company_id" position="before">
                    <field name="creating_user_id" attrs="{'readonly':[('state','!=','draft')]}" options="{'no_create': True, 'no_open':True}"/>
                </field>
                <field name="date_to" position="after">
                    <button name="update_budget_line_period" class="oe_edit_only" invisible="1"
                            type="object" string="Update Lines" style="margin-left: 10px"/>
                </field>
                <xpath expr="//notebook" position="replace">
                    <notebook>
                        <page string="Budget Lines">
                            <field name="crossovered_budget_line" context="{'default_date_from': date_from,'default_date_to': date_to}" colspan="4" nolabel="1" attrs="{'readonly':[('state','!=','draft')]}">
