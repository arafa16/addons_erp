        <record id="view_crossovered_budget_line_search" model="ir.ui.view">
            <field name="name">account.budget.line.search</field>
            <field name="model">crossovered.budget.lines</field>
            <field name="inherit_id" ref="account_budget.view_crossovered_budget_line_search"/>
            <field name="arch" type="xml">
                <field name="analytic_account_id" position="attributes">
                    <attribute name="domain">[('type','!=','view')]</attribute>
                </field>
                <field name="analytic_account_id" position="after">
                    <field name="crossovered_budget_id"/>
                    <field name="general_budget_id"/>
                    <group expand="0" string="Group By...">
                        <filter name="budget_id" string="Budgets" domain="[]" context="{'group_by':'crossovered_budget_id'}"/>
                        <filter name="budget_position" string="Budget Position" domain="[]" context="{'group_by':'general_budget_id'}"/>
                        <filter name="group" string="Budget Group" domain="[]" context="{'group_by':'group_id'}"/>
                        <filter name="cost_center" string="Cost Center" domain="[]" context="{'group_by':'cost_center_id'}"/>
                        <filter name="analytic_account" string="Analytic Account" domain="[]" context="{'group_by':'analytic_account_id'}"/>
                        <!--<filter string="Date from" context="{'group_by':'date_from'}"/>
                        <filter string="Date to" context="{'group_by':'date_to'}"/>-->
                    </group>
                </field>
            </field>
        </record>

        <record model="ir.actions.act_window" id="account_budget.act_crossovered_budget_lines_view">
            <field name="name">Budget Ledger Analysis</field>
            <field name="res_model">crossovered.budget.lines</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('state','=','ready')]</field>
            <field name="view_id" ref="view_crossovered_budget_line_tree_ledger_analysis"/>
            <field name="search_view_id" ref="account_budget.view_crossovered_budget_line_search"/>
            <field name="context">{ 'search_default_budget_id':True,
                                    'search_default_budget_position':True }</field>
        </record>

        <record model="ir.ui.view" id="view_account_analytic_account_form_inherit_budget">
            <field name="name">account.analytic.account.form</field>
            <field name="model">account.analytic.account</field>
            <field name="inherit_id" ref="account_budget.view_account_analytic_account_form_inherit_budget"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='crossovered_budget_line']/tree/field[@name='practical_amount']"
                       position="before">
                    <field name="commitment_amount"/>
                    <field name="available_amount"/>
                </xpath>
                <xpath expr="//field[@name='crossovered_budget_line']/form/field[@name='planned_amount']"
                       position="after">
                    <field name="commitment_amount"/>
                    <field name="available_amount"/>
                </xpath>
            </field>
        </record>

        <record model="ir.ui.view" id="crossovered_budget_view_tree">
            <field name="name">crossovered.budget.view.tree</field>
            <field name="model">crossovered.budget</field>
            <field name="inherit_id" ref="account_budget.crossovered_budget_view_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//tree" position="replace">
                    <tree decoration-info="state == 'draft'"
                          decoration-muted="state in ('done','cancel')"
                          default_order="date_from asc, name asc"
                          string="Budget">
                        <field name="name" colspan="1"/>
                        <field name="cost_center_id"/>
                        <field name="analytic_account_id"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="company_id" options="{'no_create': True}" groups="base.group_multi_company"/>
                        <field name="creating_user_id"/>
                        <field name="state"/>
                    </tree>
                </xpath>
            </field>
        </record>

        <record model="ir.ui.view" id="view_budget_post_group_tree">
            <field name="name">budget.post.group.tree</field>
            <field name="model">account.budget.post.group</field>
            <field name="arch" type="xml">
                <tree string="Budget Position Group">
                    <field name="name"/>
                    <field name="direction"/>
                    <field name="sign"/>
                </tree>
            </field>
        </record>

        <record id="view_budget_post_group_form" model="ir.ui.view">
            <field name="name">budget.post.group.form</field>
            <field name="model">account.budget.post.group</field>
            <field name="arch" type="xml">
                <form string="Budget Position Group">
                    <sheet string="Budget Position Group">
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1>
                                <field name="name"/>
                            </h1>
                        </div>
                        <group>
                            <field name="direction" class="oe_inline" widget="radio"/>
                            <field name="sign" class="oe_inline" widget="radio"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_budget_post_group" model="ir.actions.act_window">
            <field name="name">Budgetary Position Group</field>
            <field name="res_model">account.budget.post.group</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="view_budget_post_group_tree" />
            <field name="help" type="html">
              <p class="oe_view_nocontent_create">
                Click to record a new budget position group.
              </p>
            </field>
        </record>

        <record id="view_budget_post_report_tree" model="ir.ui.view">
            <field name="name">account.budget.post.report.tree</field>
            <field name="model">account.budget.post.list</field>
            <field name="arch" type="xml">
                <tree string="Budgetary Position">
                    <field name="group_id"/>
                    <field name="account_id"/>
                    <field name="name"/>
                    <field name="sign"/>
                    <field name="budget_type"/>
                </tree>
            </field>
        </record>
        <record id="action_budget_post_report" model="ir.actions.act_window">
            <field name="name">Budgetary Position COA List</field>
            <field name="res_model">account.budget.post.list</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree</field>
            <field name="view_id" ref="view_budget_post_report_tree"/>
        </record>

