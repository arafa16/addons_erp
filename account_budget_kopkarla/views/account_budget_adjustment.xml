<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_account_budget_adjustment_tree" model="ir.ui.view">
            <field name="name">account.budget.adjustment.tree</field>
            <field name="model">budget.adjustment</field>
            <field name="arch" type="xml">
                <tree string="Budgets Adjustment">
                    <field name="name"/>
                    <field name="description"/>
                    <field name="date"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <record id="view_account_budget_adjustment_form" model="ir.ui.view">
            <field name="name">account.budget.adjustment.form</field>
            <field name="model">budget.adjustment</field>
            <field name="arch" type="xml">
                <form string="Budgets Adjustment" domain="">
                    <header>
                        <button string="Done" name="action_budget_adjustment_done" states="draft" type="object" class="oe_highlight"/>
                        <button string="Reset to Draft" name="action_budget_adjustment_draft" states="done" type="object" />
                        <field name="state" widget="statusbar" statusbar_visible="draft,confirm"/>
                    </header>
                    <sheet string="Budget Adjustment">
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1>
                                <field name="name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="type" class="oe_inline" attrs="{'readonly':[('state','!=','draft')]}"/>
                                <field name="adjustment_amount" class="oe_inline" attrs="{'readonly':[('state','!=','draft')], 'invisible':[('type','==','control')], 'required':[('type','!=','control')]}"/>
                                <field name="adjustment_restrict" class="oe_inline" attrs="{'readonly':[('state','!=','draft')], 'invisible':[('type','!=','control')], 'required':[('type','==','control')]}" />
                            </group>
                            <group>
                                <field name="date" class="oe_inline" attrs="{'readonly':[('state','!=','draft')]}"/>
                                <field name="creating_user_id" attrs="{'readonly':[('state','!=','draft')]}"/>
                                <field name="description" attrs="{'readonly':[('state','!=','draft')]}"/>
                                <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Header">
                                <group colspan="4">
                                    <group string="Budget to adjust">
                                        <button colspan="2" string="Click here to adjsut a budget" name="action_get_budget" context="{'budget_position': 'adjust'}"
                                                style="width:100%" type="object" class="btn-info" attrs="{'invisible': [('state', '=', 'done')]}"/>
                                        <field name="budget_line_id_adj"/>
                                        <field name="cost_center_id_adj"/>
                                        <field name="analytic_account_id_adj"/>
                                        <field name="date_from_adj"/>
                                        <field name="date_to_adj"/>
                                        <field name="restrict_allow_adj"/>
                                        <field name="avail_req_amount_adj"/>
                                    </group>
                                    <group string="Budget source" attrs="{'invisible':[('type','!=','transfer')]}">
                                        <button colspan="2" string="Budget Source" name="action_get_budget" context="{'budget_position': 'source'}"
                                                style="width:100%" type="object" class="btn-secondary" attrs="{'invisible': [('state', '=', 'done')]}"/>
                                        <field name="budget_line_id_src"/>
                                        <field name="cost_center_id_src"/>
                                        <field name="analytic_account_id_src"/>
                                        <field name="date_from_src"/>
                                        <field name="date_to_src"/>
                                        <field name="restrict_allow_src"/>
                                        <field name="avail_req_amount_src"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Lines">
                                <field name="line_ids">
                                    <tree string="Budget Adjustment Lines">
                                        <field name="budget_line_id"/>
                                        <field name="cost_center_id"/>
                                        <field name="analytic_account_id"/>
                                        <field name="date_from"/>
                                        <field name="date_to"/>
                                        <field name="restrict" attrs="{'column_invisible':[('parent.type','!=','control')]}"/>
                                        <field name="amount" attrs="{'column_invisible':[('parent.type','==','control')]}"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>

                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="view_budget_adjustment_search" model="ir.ui.view">
            <field name="name">budget.adjustment.search</field>
            <field name="model">budget.adjustment</field>
            <field name="arch" type="xml">
                <search string="Budget Adjustment">
                    <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                    <filter string="Done" name="done" domain="[('state','=', 'done')]"/>
                    <separator/>
                    <filter string="This Month" name="this_month" domain="[('date', '&gt;=', context_today().strftime('%%Y-%%m-01'))]"/>
                    <filter string="Last Month" name="last_month" domain="['&amp;', ('date', '&gt;=', (context_today() - relativedelta(months=1)).strftime('%%Y-%%m-01')), ('date', '&lt;', context_today().strftime('%%Y-%%m-01'))]"/>
                    <group expand="1" string="Group By">
                        <filter string="Budget To" name='budget_to' context="{'group_by':'budget_line_id_adj'}"/>
                        <filter string="Cost Center To" name='cost_center_to' context="{'group_by':'cost_center_id_adj'}"/>
                        <filter string="Analytic Account To" name='anaytic_account_to' context="{'group_by':'analytic_account_id_adj'}"/>
                        <separator/>
                        <filter string="Budget From" name='budget_from' context="{'group_by':'budget_line_id_src'}"/>
                        <filter string="Cost Center From" name='cost_center_from' context="{'group_by':'cost_center_id_src'}"/>
                        <filter string="Analytic Account From" name='anaytic_account_from' context="{'group_by':'analytic_account_id_src'}"/>
                        <separator orientation="vertical"/>
                        <filter string="Date" context="{'group_by':'date'}"/>
                        <separator/>
                        <filter string="Status" context="{'group_by':'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record model="ir.actions.act_window" id="act_budget_adjustment_view">
            <field name="name">Budgets Adjustment</field>
            <field name="res_model">budget.adjustment</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="view_account_budget_adjustment_tree"/>
<!--            <field name="search_view_id" ref="view_crossovered_budget_search"/>-->
<!--            <field name="help" type="html">-->
        </record>

        <menuitem parent="menu_budget_documents"
            id="menu_act_budget_adjustment_view"
            name="Budgets Adjustment"
            action="act_budget_adjustment_view" sequence="4"
            groups="account.group_account_user"/>
    </data>
</odoo>