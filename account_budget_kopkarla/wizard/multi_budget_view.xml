                    <label string="All selected budgets will be done."/>
                    <footer>
                        <button string="Done" name="done_budgets" type="object" default_focus="1" class="btn-primary"/>
                        <button string="Cancel" class="btn-default" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_done_budget" model="ir.actions.act_window">
            <field name="name">Archive Budgets</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">done.budget</field>
            <field name="view_type">form</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="done_multi_budget_view"/>
            <field name="context">{}</field>
            <field name="target">new</field>
            <field name="help">This wizard will done all budget selected.</field>
            <field name="binding_model_id" ref="account_budget_kopkarla.model_crossovered_budget" />
