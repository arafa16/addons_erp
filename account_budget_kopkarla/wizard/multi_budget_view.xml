<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="confirm_multi_budget_view" model="ir.ui.view">
            <field name="name">Confirm Budgets</field>
            <field name="model">confirm.budget</field>
            <field name="arch" type="xml">
                <form string="Confirm Budget">
                    <label string="All selected budgets will be confirm. You won't be able to modify them afterwards."/>
                    <footer>
                        <button string="Confirm" name="confirm_budgets" type="object" default_focus="1" class="btn-primary"/>
                        <button string="Cancel" class="btn-default" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_confirm_budget" model="ir.actions.act_window">
            <field name="name">Confirm Budgets</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">confirm.budget</field>
            <field name="view_type">form</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="confirm_multi_budget_view"/>
            <field name="context">{}</field>
            <field name="target">new</field>
            <field name="help">This wizard will confirm all budget selected. Once budget are confirmed, you can not update them anymore.</field>
            <field name="binding_model_id" ref="account_budget_kopkarla.model_crossovered_budget" />
        </record>


        <record id="validate_multi_budget_view" model="ir.ui.view">
            <field name="name">Validate Budgets</field>
            <field name="model">validate.budget</field>
            <field name="arch" type="xml">
                <form string="Validate Budget">
                    <label string="All selected budgets will be validate."/>
                    <footer>
                        <button string="Validate" name="validate_budgets" type="object" default_focus="1" class="btn-primary"/>
                        <button string="Cancel" class="btn-default" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_validate_budget" model="ir.actions.act_window">
            <field name="name">Validate Budgets</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">validate.budget</field>
            <field name="view_type">form</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="validate_multi_budget_view"/>
            <field name="context">{}</field>
            <field name="target">new</field>
            <field name="help">This wizard will validate all budget selected.</field>
            <field name="binding_model_id" ref="account_budget_kopkarla.model_crossovered_budget" />
        </record>


