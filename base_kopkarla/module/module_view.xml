<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Click on a category -->
        <record id="view_module_filter" model="ir.ui.view">
            <field name="name">ir.module.module.list.select</field>
            <field name="model">ir.module.module</field>
            <field name="inherit_id" ref="base.view_module_filter"/>
            <field name="arch" type="xml">
                <field name="name" position="after">
                    <filter name="author" string="TBD Modules" domain="[('author', '=', 'TBD Team')]"/>
                </field>
                <xpath expr="//group[last()]" position="after">
                    <filter name="maintainer" string="Company" domain="[]" context="{'group_by':'maintainer'}"/>
                </xpath>
            </field>
        </record>
        <record id="base.open_module_tree" model="ir.actions.act_window">
            <field name="name">Apps</field>
            <field name="res_model">ir.module.module</field>
            <field name="view_type">form</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="context">{'search_default_author': 1}</field>
            <field name="search_view_id" ref="base.view_module_filter"/>
            <field name="help" type="html">
              <p><b>No module found!</b></p>
              <p>You should try other search criteria.</p>
            </field>
        </record>
    </data>
</odoo>
