<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_partner_bank_form_kopkarla" model="ir.ui.view">
            <field name="name">res.partner.bank.form.kopkarla</field>
            <field name="model">res.partner.bank</field>
            <field name="inherit_id" ref="base.view_partner_bank_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form" position="replace">
                    <form string="Bank account">
                        <group>
                            <field name="sequence" invisible="1"/>
                            <field name="acc_number"/>
                            <field name="acc_name" required="1"/>
                            <field name="bank_id" required="1"/>
                            <field name="currency_id" groups="base.group_multi_currency" options="{'no_create': True}" required="1"/>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                            <field name="partner_id" required="1"/>
                        </group>
                    </form>
                </xpath>
            </field>
        </record>
    </data>
</odoo>

